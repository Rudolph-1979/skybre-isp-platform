"""Allocating a payment across the invoices it actually settles.

The gap this fills: a Payment with an `invoice` credits that one invoice's
paid_amount, and a Payment without one only moves Customer.balance. Bank
feeds take the second path (confirm posts a customer, never an invoice), so
the normal case leaves a customer square on their balance while every
invoice still reads UNPAID -- wrong on the invoice list, the aging report,
the statement and the customer portal.

The rule that keeps the ledger honest: **the balance moves exactly once, when
the payment is recorded** (PaymentSerializer.create, with F()). Allocation
only distributes money the balance has already accounted for across the
invoices it pays off. Nothing in this module touches Customer.balance, and
anything that starts doing so is a double-count.

Conventions copied deliberately from the rest of billing:
  * invoices are re-read under select_for_update() rather than trusting a
    copy loaded during validation -- two EFTs allocated to one invoice at
    the same time each added to the paid_amount they had read, and one
    vanished;
  * saves are update_fields=["paid_amount", "status"], never a full save(),
    which would write this request's stale status and balance_debited over
    a concurrent apply_balance_debit;
  * invoices are locked in a deterministic order (by pk) so two staff
    members allocating overlapping sets cannot deadlock.
"""
from decimal import Decimal

from django.db import transaction
from django.db.models import F, Sum

from .models import CreditAllocation, CreditRequest, Invoice, Payment, PaymentAllocation

ZERO = Decimal("0")

# The same set PaymentSerializer.validate refuses a direct payment against,
# and for the same reasons: quotes and pro formas are not debts yet, a
# cancelled invoice is not owed, and a draft has never been issued so
# nothing debited the balance for it.
UNALLOCATABLE_STATUSES = tuple(Invoice.PRE_INVOICE_STATUSES) + (
    Invoice.Status.CANCELLED,
    Invoice.Status.DRAFT,
)


class AllocationError(Exception):
    """Something about this allocation doesn't add up. Carries a message
    written for the person doing the mapping, not for a log."""


def open_invoices(customer):
    """This customer's invoices with money still outstanding, oldest due
    first -- the order staff allocate in, and the order auto_allocate
    fills."""
    return (
        Invoice.objects.filter(customer=customer)
        .exclude(status__in=UNALLOCATABLE_STATUSES)
        .filter(paid_amount__lt=F("total"))
        .order_by("date_due", "pk")
    )


def allocated_total(payment) -> Decimal:
    return payment.allocations.aggregate(total=Sum("amount"))["total"] or ZERO


def unallocated_amount(payment) -> Decimal:
    """What of this payment is not yet pinned to an invoice. Negative
    payments (the "Manual Adjustment" ledger correction path) are never
    allocatable, so they report nothing outstanding."""
    if payment.amount <= ZERO:
        return ZERO
    return payment.amount - allocated_total(payment)


def _apply(invoice, amount):
    """Move `amount` onto a locked invoice's paid_amount."""
    invoice.paid_amount = invoice.paid_amount + amount
    if invoice.paid_amount >= invoice.total and invoice.total > ZERO:
        invoice.status = Invoice.Status.PAID
    invoice.save(update_fields=["paid_amount", "status"])


def _unapply(invoice, amount):
    """Take `amount` back off a locked invoice's paid_amount. Mirrors
    Payment.reverse_ledger_effect: an invoice that had been flipped to Paid
    goes back to Unpaid, and anything that was not Paid is left alone -- a
    cancelled invoice does not become unpaid because an allocation against
    it was undone."""
    invoice.paid_amount = invoice.paid_amount - amount
    if invoice.status == Invoice.Status.PAID and invoice.paid_amount < invoice.total:
        invoice.status = Invoice.Status.UNPAID
    invoice.save(update_fields=["paid_amount", "status"])


def allocate(payment, pairs, user=None):
    """Pin parts of `payment` to specific invoices.

    `pairs` is an iterable of (invoice_id, amount). Returns the created
    PaymentAllocation rows. All-or-nothing: one bad line rejects the whole
    mapping, because a half-applied allocation is the worst of the three
    possible outcomes.
    """
    cleaned = []
    for invoice_id, amount in pairs:
        amount = Decimal(str(amount))
        if amount <= ZERO:
            raise AllocationError("An allocation of zero or less has no effect.")
        cleaned.append((int(invoice_id), amount))
    if not cleaned:
        raise AllocationError("Nothing to allocate.")

    seen = set()
    for invoice_id, _ in cleaned:
        if invoice_id in seen:
            raise AllocationError("The same invoice appears twice in one mapping.")
        seen.add(invoice_id)

    created = []
    with transaction.atomic():
        # Lock the payment first: the check "is there enough of this payment
        # left" and the writes that consume it have to be one step, or two
        # people mapping the same EFT can each allocate the full amount.
        locked_payment = Payment.objects.select_for_update().get(pk=payment.pk)
        if locked_payment.amount <= ZERO:
            raise AllocationError(
                "A zero or negative payment can't be allocated to invoices -- it is a ledger "
                "adjustment, not money received."
            )

        remaining = unallocated_amount(locked_payment)
        requested = sum(amount for _, amount in cleaned)
        if requested > remaining:
            raise AllocationError(
                "That allocates R%s but only R%s of this payment is unallocated."
                % (requested, remaining)
            )

        for invoice_id, amount in sorted(cleaned):
            try:
                invoice = Invoice.objects.select_for_update().get(pk=invoice_id)
            except Invoice.DoesNotExist:
                raise AllocationError("Invoice %s no longer exists." % invoice_id)

            if invoice.customer_id != locked_payment.customer_id:
                raise AllocationError(
                    "%s belongs to a different customer." % (invoice.number or invoice_id)
                )
            if invoice.status in UNALLOCATABLE_STATUSES:
                raise AllocationError(
                    "%s is a %s -- nothing is owed on it."
                    % (invoice.number or invoice_id, invoice.get_status_display().lower())
                )
            if PaymentAllocation.objects.filter(
                payment=locked_payment, invoice=invoice
            ).exists():
                # The (payment, invoice) pair is unique -- one row per pair,
                # so re-mapping the same invoice means replacing or undoing
                # the existing line rather than adding a second one. Caught
                # here so it reads as a sentence instead of an IntegrityError.
                raise AllocationError(
                    "%s already has part of this payment allocated to it. Clear the mapping "
                    "first (or use Replace) to change it."
                    % (invoice.number or invoice_id)
                )
            if amount > invoice.balance_due:
                raise AllocationError(
                    "%s only has R%s outstanding; R%s was allocated to it."
                    % (invoice.number or invoice_id, invoice.balance_due, amount)
                )

            created.append(
                PaymentAllocation.objects.create(
                    payment=locked_payment, invoice=invoice, amount=amount, created_by=user
                )
            )
            _apply(invoice, amount)
    return created


def auto_allocate(payment, user=None):
    """Fill oldest due first with whatever of the payment is unallocated,
    capped per invoice at what is still owed on it. Any remainder stays
    unallocated and sits as account credit -- which is what the balance
    already does, so there is nothing extra to explain to anyone."""
    remaining = unallocated_amount(payment)
    if remaining <= ZERO:
        return []
    # An invoice this payment has already been mapped to is left alone: its
    # row exists, the pair is unique, and topping it up would need the
    # existing line replaced rather than a second one added.
    already = set(payment.allocations.values_list("invoice_id", flat=True))
    pairs = []
    for invoice in open_invoices(payment.customer):
        if invoice.pk in already:
            continue
        if remaining <= ZERO:
            break
        take = min(remaining, invoice.balance_due)
        if take > ZERO:
            pairs.append((invoice.pk, take))
            remaining -= take
    if not pairs:
        return []
    return allocate(payment, pairs, user=user)


def unallocate(allocation):
    """Undo one allocation, putting the money back to unallocated."""
    with transaction.atomic():
        invoice = Invoice.objects.select_for_update().get(pk=allocation.invoice_id)
        _unapply(invoice, allocation.amount)
        allocation.delete()


def reverse_allocations(payment):
    """Undo every allocation on this payment.

    Called by Payment.reverse_ledger_effect before a payment is deleted.
    The rows would disappear on CASCADE anyway -- the point is to take the
    money back off each invoice's paid_amount first, or deleting a mapped
    payment would leave its invoices reading as paid by money that no
    longer exists.
    """
    for allocation in list(
        payment.allocations.all().order_by("invoice_id").select_related(None)
    ):
        if allocation.invoice_id is None:
            allocation.delete()
            continue
        invoice = Invoice.objects.select_for_update().get(pk=allocation.invoice_id)
        _unapply(invoice, allocation.amount)
        allocation.delete()


def summarise(payment):
    """What the mapping screen needs to render one payment."""
    return {
        "payment": payment.pk,
        "customer": payment.customer_id,
        "amount": str(payment.amount),
        "allocated": str(allocated_total(payment)),
        "unallocated": str(unallocated_amount(payment)),
        "allocations": [
            {
                "id": a.pk,
                "invoice": a.invoice_id,
                "invoice_number": a.invoice.number if a.invoice_id else "",
                "amount": str(a.amount),
                "created_at": a.created_at.isoformat(),
                "created_by_name": getattr(a.created_by, "username", None),
            }
            for a in payment.allocations.select_related("invoice", "created_by").all()
        ],
    }


# --- one rule for every source of money (5 Oct 2026) ---------------------
#
# Rudolph: "Payments should always be auto allocated to oldest invoice with
# a option to allocate payments to specific invoices." So every rand that
# reaches an account -- a payment, or an approved credit -- settles the
# client's open invoices oldest due first, unless staff pinned it to a
# specific invoice, and it does so whenever either side changes: money in
# (payment recorded, credit approved), or debt in/out (invoice issued,
# cancelled, deleted). sweep_customer() is that rule; everything below
# feeds it. Customer.balance is never touched here -- it moved once, when
# the money or the invoice was recorded.

import logging  # noqa: E402

logger = logging.getLogger(__name__)


def _is_imported(payment):
    from .statements import is_imported_note

    return is_imported_note(payment.note)


def credit_allocated_total(credit) -> Decimal:
    return credit.allocations.aggregate(total=Sum("amount"))["total"] or ZERO


def credit_unallocated_amount(credit) -> Decimal:
    """What of an approved, tracked credit is not yet settling an invoice.
    Legacy credits (approved before tracking) and anything not Approved
    report nothing -- their effect is already wherever it landed."""
    if credit.status != CreditRequest.Status.APPROVED or not credit.allocation_tracked:
        return ZERO
    return max(ZERO, credit.amount - credit_allocated_total(credit))


def allocate_credit(credit, pairs, user=None):
    """Pin parts of an approved credit to specific invoices. Same rules and
    locking as allocate() for payments."""
    created = []
    with transaction.atomic():
        locked = CreditRequest.objects.select_for_update().get(pk=credit.pk)
        remaining = credit_unallocated_amount(locked)
        for invoice_id, amount in sorted((int(i), Decimal(str(a))) for i, a in pairs):
            if amount <= ZERO:
                continue
            if amount > remaining:
                raise AllocationError(
                    "That allocates more of this credit than is left (R%s)." % remaining
                )
            invoice = Invoice.objects.select_for_update().get(pk=invoice_id)
            if invoice.customer_id != locked.customer_id:
                raise AllocationError("%s belongs to a different customer." % (invoice.number or invoice_id))
            if invoice.status in UNALLOCATABLE_STATUSES:
                raise AllocationError("%s is not owed." % (invoice.number or invoice_id))
            if amount > invoice.balance_due:
                raise AllocationError(
                    "%s only has R%s outstanding." % (invoice.number or invoice_id, invoice.balance_due)
                )
            if CreditAllocation.objects.filter(credit=locked, invoice=invoice).exists():
                raise AllocationError(
                    "%s already has part of this credit on it. Clear the mapping first (or use Replace)."
                    % (invoice.number or invoice_id)
                )
            created.append(CreditAllocation.objects.create(
                credit=locked, invoice=invoice, amount=amount, created_by=user,
            ))
            _apply(invoice, amount)
            remaining -= amount
    return created


def auto_allocate_credit(credit, user=None):
    """Fill oldest due first with whatever of the credit is unallocated."""
    remaining = credit_unallocated_amount(credit)
    if remaining <= ZERO:
        return []
    already = set(credit.allocations.values_list("invoice_id", flat=True))
    pairs = []
    for invoice in open_invoices(credit.customer):
        if invoice.pk in already:
            continue
        if remaining <= ZERO:
            break
        take = min(remaining, invoice.balance_due)
        if take > ZERO:
            pairs.append((invoice.pk, take))
            remaining -= take
    return allocate_credit(credit, pairs, user=user) if pairs else []


def allocate_approved_credit(credit, user=None):
    """A credit just approved: its linked invoice first (if any, capped at
    what is owed on it), then the rest oldest-first. Anything left over
    stays as account credit and is picked up by the next invoice raised."""
    credit.refresh_from_db()
    if credit.invoice_id:
        invoice = Invoice.objects.filter(pk=credit.invoice_id).first()
        if (
            invoice is not None
            and invoice.customer_id == credit.customer_id
            and invoice.status not in UNALLOCATABLE_STATUSES
            and invoice.balance_due > ZERO
        ):
            allocate_credit(credit, [(invoice.pk, min(credit.amount, invoice.balance_due))], user=user)
    return auto_allocate_credit(credit, user=user)


def settle_payment(payment, preferred_invoice_id=None, user=None):
    """A payment just recorded: the invoice staff recorded it against first
    (capped at what is owed on it), then the rest oldest-first. Replaces
    the old "credit that one invoice directly" path, which had no cap (an
    overpayment stuck to the invoice) and wrote no allocation row (so it
    could never be moved)."""
    if preferred_invoice_id:
        invoice = Invoice.objects.filter(pk=preferred_invoice_id).first()
        if (
            invoice is not None
            and invoice.customer_id == payment.customer_id
            and invoice.status not in UNALLOCATABLE_STATUSES
            and invoice.balance_due > ZERO
        ):
            take = min(unallocated_amount(payment), invoice.balance_due)
            if take > ZERO:
                allocate(payment, [(invoice.pk, take)], user=user)
    return auto_allocate(payment, user=user)


def release_invoice(invoice):
    """Take every allocation (payment and credit) off one invoice, putting
    that money back to unallocated. For an invoice that stops being owed."""
    with transaction.atomic():
        locked = Invoice.objects.select_for_update().get(pk=invoice.pk)
        for allocation in list(PaymentAllocation.objects.filter(invoice=locked)):
            _unapply(locked, allocation.amount)
            allocation.delete()
            locked.refresh_from_db()
        for allocation in list(CreditAllocation.objects.filter(invoice=locked)):
            _unapply(locked, allocation.amount)
            allocation.delete()
            locked.refresh_from_db()
    invoice.paid_amount = locked.paid_amount
    invoice.status = locked.status


def release_credit(credit):
    """Undo everything one credit settled (credit note deleted)."""
    for allocation in list(credit.allocations.all().order_by("invoice_id")):
        invoice = Invoice.objects.select_for_update().get(pk=allocation.invoice_id)
        _unapply(invoice, allocation.amount)
        allocation.delete()


def sweep_customer(customer_id, user=None):
    """Apply every unapplied rand this client has -- payments and tracked
    credits, oldest money first -- to their open invoices, oldest due
    first. Idempotent: with nothing unapplied or nothing open it does
    nothing. Leaves alone what it must not double-count: imported payments
    (their invoices carry the old system's paid amounts), legacy payments
    recorded straight against an invoice, negative adjustments, and legacy
    credits."""
    sources = []
    for payment in Payment.objects.filter(customer_id=customer_id, invoice__isnull=True, amount__gt=0):
        if _is_imported(payment) or unallocated_amount(payment) <= ZERO:
            continue
        sources.append((payment.date, 0, payment))
    for credit in CreditRequest.objects.filter(
        customer_id=customer_id, status=CreditRequest.Status.APPROVED, allocation_tracked=True,
    ):
        if credit_unallocated_amount(credit) <= ZERO:
            continue
        sources.append((credit.decided_at or credit.created_at, 1, credit))
    done = []
    for _, kind, source in sorted(sources, key=lambda s: (s[0], s[1], s[2].pk)):
        if not open_invoices_exist(customer_id):
            break
        if kind == 0:
            done += auto_allocate(source, user=user)
        else:
            done += auto_allocate_credit(source, user=user)
    done += _settle_from_imported(customer_id, user=user)
    return done


def balance_backed_cover(customer_id):
    """How much of the client's open invoices their own account balance
    says is already paid: what the invoices show owed, minus what the
    balance actually says they owe (never below zero). R0 for an account
    whose invoices and balance agree."""
    from customers.models import Customer

    balance = Customer.objects.filter(pk=customer_id).values_list("balance", flat=True).first() or ZERO
    showing = sum((i.balance_due for i in open_invoices_for_id(customer_id)), ZERO)
    return max(ZERO, showing - max(balance, ZERO))


def open_invoices_for_id(customer_id):
    return (
        Invoice.objects.filter(customer_id=customer_id)
        .exclude(status__in=UNALLOCATABLE_STATUSES)
        .filter(paid_amount__lt=F("total"))
        .order_by("date_due", "pk")
    )


def _settle_from_imported(customer_id, user=None):
    """Money brought across by the Splynx imports is never auto-allocated
    in full -- the imported invoices already carry the old system's paid
    amounts, so treating every imported payment as unapplied would pay
    them twice. But an imported account can arrive IN CREDIT (CCTV Central,
    5 Oct 2026: balance R0.00, its first new invoice still R435.85 Unpaid
    -- the prepaid money was absorbed by the balance and never reached the
    invoice). So imported payments may settle open invoices only up to
    what the balance itself proves is covered (balance_backed_cover), and
    no further -- the invoices can then never claim more paid than the
    account actually has."""
    cover = balance_backed_cover(customer_id)
    if cover <= ZERO:
        return []
    done = []
    for payment in Payment.objects.filter(
        customer_id=customer_id, invoice__isnull=True, amount__gt=0,
    ).order_by("date", "pk"):
        if cover <= ZERO:
            break
        if not _is_imported(payment):
            continue
        left = unallocated_amount(payment)
        if left <= ZERO:
            continue
        already = set(payment.allocations.values_list("invoice_id", flat=True))
        pairs = []
        budget = min(left, cover)
        for invoice in open_invoices_for_id(customer_id):
            if budget <= ZERO:
                break
            if invoice.pk in already:
                continue
            take = min(budget, invoice.balance_due)
            if take > ZERO:
                pairs.append((invoice.pk, take))
                budget -= take
        if pairs:
            done += allocate(payment, pairs, user=user)
            cover -= sum((a for _, a in pairs), ZERO)
    return done


def open_invoices_exist(customer_id):
    return (
        Invoice.objects.filter(customer_id=customer_id)
        .exclude(status__in=UNALLOCATABLE_STATUSES)
        .filter(paid_amount__lt=F("total"))
        .exists()
    )


def sweep_after_commit(customer_id):
    """sweep_customer once the current transaction commits -- so it sees the
    invoice/payment that triggered it -- and never raising into the caller:
    a sweep that fails is a support call, the save that triggered it must
    still stand."""
    def run():
        try:
            sweep_customer(customer_id)
        except Exception:
            logger.exception("Allocation sweep for customer %s failed", customer_id)

    transaction.on_commit(run)


def summarise_credit(credit):
    """What the mapping screen needs to render one credit -- same shape as
    summarise() for a payment, so one screen serves both."""
    return {
        "credit": credit.pk,
        "customer": credit.customer_id,
        "amount": str(credit.amount),
        "allocated": str(Decimal(credit_allocated_total(credit)).quantize(Decimal("0.01"))),
        "unallocated": str(Decimal(credit_unallocated_amount(credit)).quantize(Decimal("0.01"))),
        "allocation_tracked": credit.allocation_tracked,
        "allocations": [
            {
                "id": a.pk,
                "invoice": a.invoice_id,
                "invoice_number": a.invoice.number if a.invoice_id else "",
                "amount": str(a.amount),
                "created_at": a.created_at.isoformat(),
                "created_by_name": getattr(a.created_by, "username", None),
            }
            for a in credit.allocations.select_related("invoice", "created_by").all()
        ],
    }
