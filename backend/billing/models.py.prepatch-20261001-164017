class SuspensionSettings(models.Model):
    """Singleton (pk=1) global master switch for auto-suspension --
    mirrors ReminderSettings' "global kill-switch on top of per-customer
    settings" shape. A customer's own blocking_period_days (see
    RecurringBillingFieldsMixin) only actually suspends anything if this
    switch is ALSO on; individual customers can't override this, same
    convention as ReminderSettings. Deliberately its own tiny model rather
    than a field on BillingDefaults -- BillingDefaults is a per-customer
    *template* (each field gets copied onto, and can then be overridden
    per, a CustomerBillingConfig), whereas this is a true platform-wide
    switch nothing per-customer can bypass, the same role ReminderSettings
    already plays for reminders.

    Defaults to OFF on a fresh install/migrate, matching the behavior this
    replaces (auto-suspension was previously only reachable by editing
    every customer's blocking_period_days by hand, with no single place to
    confirm or flip it off in a hurry)."""

    auto_suspend_enabled = models.BooleanField(
        default=False,
        help_text=(
            "Master switch for auto-suspension. When off, the recurring-billing engine never "
            "suspends anyone, regardless of any customer's own blocking_period_days. When on, "
            "suspension still only applies to customers who are billing_enabled AND have a "
            "blocking_period_days set."
        ),
    )
    # The warning, and its own switch.
    #
    # Separate from auto_suspend_enabled on purpose, and usable while that
    # is OFF: warning people their line is heading for a cut-off is
    # something you might well want to do for a cycle or two before
    # arming the cut-off itself. The reverse -- suspending without ever
    # having warned -- is the situation this field exists to end.
    warning_enabled = models.BooleanField(
        default=True,
        help_text=(
            "Email customers before their line is suspended, naming the date. Independent of "
            "the master switch above: warnings can run while auto-suspension is still off."
        ),
    )
    warning_days = models.PositiveSmallIntegerField(
        default=3,
        help_text=(
            "How many days before the cut-off the warning goes out. 3 means a customer due to "
            "be suspended on the 25th is warned on the 22nd."
        ),
    )
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        verbose_name = "Suspension settings"
        verbose_name_plural = "Suspension settings"

    def __str__(self):
        return "Suspension settings"

    @classmethod
    def load(cls):
        obj, _ = cls.objects.get_or_create(pk=1)
        return obj


class CustomerBillingConfig(RecurringBillingFieldsMixin):
    """Per-customer recurring-billing configuration -- see
    RecurringBillingFieldsMixin for the shared fields this mirrors from
    BillingDefaults. Deliberately opt-in: billing_enabled defaults to False
    for every customer (including ones touched by
    BillingDefaults.apply_to_existing_customers()), so turning this
    feature on for a given customer is always a specific action a staff
    member takes, never a side effect of a global settings change."""

    customer = models.OneToOneField("customers.Customer", on_delete=models.CASCADE, related_name="billing_config")
    billing_enabled = models.BooleanField(
        default=False,
        help_text="Whether recurring invoicing/reminders/auto-suspension run for this customer at all.",
    )
    # Optional override for finance documents -- customer's own
    # address/city/etc. is used if these are left blank.
    billing_name = models.CharField(max_length=255, blank=True)
    billing_street = models.CharField(max_length=255, blank=True)
    billing_zip = models.CharField(max_length=20, blank=True)
    billing_city = models.CharField(max_length=100, blank=True)
    # Tracks the next date this customer is due to be (re-)invoiced -- set
    # the first time the recurring-billing engine bills them, then advanced
    # by payment_period each time, so re-running the engine on the same (or
    # a later, still-within-cycle) day never double-bills them.
    next_billing_date = models.DateField(null=True, blank=True)
    # The DAY a suspension warning was last sent to this customer.
    #
    # The warning is a daily countdown -- "3 days", "2 days", "1 day" --
    # so a customer is warned once on each day of the notice period, and
    # this field exists to stop a second send on the same day when the
    # command and a Run both happen, or when either is re-run.
    #
    # On the CONFIG rather than the invoice, because a cut-off is about the
    # customer's overall position (balance against minimum balance, plus
    # their oldest owing invoice), not about one document.
    suspension_warned_on = models.DateField(null=True, blank=True)
    # Pauses suspension AND the reminder/warning chasers for this customer
    # through this date (inclusive) -- e.g. "they promised to pay by
    # Friday." Set only by SuspensionExtensionRequestViewSet.approve, never
    # edited directly (see CustomerBillingConfigSerializer). Checked by
    # blocking_candidate_services, suspension_block_date and
    # _process_reminders in billing/recurring.py -- once run_date passes
    # this date it simply stops having any effect, so no expiry job is
    # needed and the date is left in place afterwards as a record of the
    # last extension granted.
    suspension_extended_until = models.DateField(null=True, blank=True)
    #: The last month ("2026-09") this customer was sent a statement for.
    #:
    #: Keyed on the PERIOD rather than on a send date, for the reason the
    #: reminder dedupe gives: a date says "something was attempted today",
    #: which a re-run on a later day sails straight past, and which a
    #: failed send sets just as readily as a successful one. The period is
    #: the thing actually being deduplicated -- this customer, this month,
    #: once -- and it is written only after the mailer says the send
    #: succeeded.
    statement_sent_for = models.CharField(max_length=7, blank=True)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        ordering = ["-created_at"]

    def __str__(self):
        return f"Billing config for {self.customer}"

    @classmethod
    def for_customer(cls, customer):
        """Get-or-create, seeded from BillingDefaults the first time --
        same lazy-singleton convention as EmailSettings.load(), just keyed
        per customer rather than platform-wide."""
        obj, created = cls.objects.get_or_create(customer=customer)
        if created:
            obj.apply_defaults(BillingDefaults.load())
        return obj

    def apply_defaults(self, defaults):
        """Copies every SHARED_FIELDS value from BillingDefaults onto this
        customer's config -- deliberately never touches billing_enabled.
        Used both the first time a config is created and by "Apply to
        existing customers" (see BillingDefaultsView.apply_to_existing)."""
        for field in self.SHARED_FIELDS:
            setattr(self, field, getattr(defaults, field))
        self.save()

    def apply_payment_method(self, method):
        """Copy a payment method's terms onto this customer's config and
        point the customer at that method.

        A copy, not a link -- see PaymentMethod's docstring for why.
        Never touches billing_enabled, same as apply_defaults."""
        for field in PaymentTermsMixin.TERMS_FIELDS:
            setattr(self, field, getattr(method, field))
        self.payment_method = method
        self.save()


class RecurringBillingRun(models.Model):
    """One row per committed run of the recurring-billing engine (see
    billing.recurring.run_recurring_billing) -- what Finance -> Recurring
    Billing's History table lists. A *preview* (commit=False) never
    creates one of these; only an actual Run does, whether it succeeds or
    fails partway (see status/status_message)."""

    class Status(models.TextChoices):
        # The state a run is created in, and the one it is left in if it
        # never reaches the end. The default used to be PROCESSED, so a
        # run killed halfway -- a container restart, a deploy, the
        # process going away -- left a row reading "Processed, 0
        # invoices" on top of invoices that had committed, balances that
        # had been debited and PDFs already in customers' inboxes.
        # Nothing on the row said otherwise, and the obvious recovery
        # from it (run it again, History says nothing happened) is
        # exactly what would double-bill everybody.
        IN_PROGRESS = "in_progress", "In progress"
        PROCESSED = "processed", "Processed"
        FAILED = "failed", "Failed"

    run_date = models.DateField(help_text="The billing date this run was for.")
    created_at = models.DateTimeField(auto_now_add=True)
    status = models.CharField(max_length=15, choices=Status.choices, default=Status.IN_PROGRESS)
    status_message = models.CharField(max_length=255, blank=True)
    partners = models.ManyToManyField(
        "customers.Partner", blank=True, related_name="recurring_billing_runs",
        help_text="Which partners' customers this run was scoped to. Empty = every partner.",
    )
    invoices_created_count = models.PositiveIntegerField(default=0)
    proforma_invoices_created_count = models.PositiveIntegerField(default=0)
    reminders_sent_count = models.PositiveIntegerField(default=0)
    suspension_warnings_sent_count = models.PositiveIntegerField(default=0)
    suspensions_applied_count = models.PositiveIntegerField(default=0)
    triggered_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, blank=True, related_name="+",
        help_text="The staff member who clicked Run. Every run is staff-triggered this release -- see the design doc's phased rollout.",
    )

    class Meta:
        ordering = ["-created_at"]

    def __str__(self):
        return f"Recurring billing run {self.run_date} ({self.status})"


class BillingPreviewSnapshot(models.Model):
    """A saved recurring-billing Preview -- the document finance reviews, and
    the approval that unlocks Run for it.

    Why the sheets are stored rather than regenerated on download: an
    approval has to be an approval OF something. If the CSV were rebuilt at
    download time, the file someone signed off on and the file they later
    open could differ, and there would be no way to tell. The sheets here are
    exactly the bytes that were reviewed.

    `fingerprint` is taken over the projected numbers only (see
    preview_export.projection_digest), not over the moment they were
    produced -- so re-previewing unchanged data reproduces the same
    fingerprint, and any change to a tariff, service or customer in between
    produces a different one. Run recomputes the fingerprint and refuses if
    it no longer matches the approved snapshot, which is what stops a stale
    approval from billing something nobody agreed to.

    Snapshots are kept, not cleaned up: they are the audit trail of who
    approved which billing run. A month of previews is a few hundred KB.
    """

    run_date = models.DateField(help_text="The billing date this preview was taken for.")
    # Stored as ids rather than an M2M so a snapshot's scope is frozen even
    # if a partner is later renamed or deleted -- and so scope comparison at
    # Run time is a plain equality check against the same sorted list the
    # request produced.
    partner_ids = models.JSONField(default=list, blank=True)
    fingerprint = models.CharField(max_length=16, db_index=True)
    engine = models.CharField(max_length=10, default="", editable=False)

    counts = models.JSONField(default=dict)
    grand_total = models.DecimalField(max_digits=14, decimal_places=2, default=0)
    # {"invoice": "<csv text>", "transaction": ..., "reminder": ..., "suspension": ...}
    sheets = models.JSONField(default=dict)

    created_at = models.DateTimeField(auto_now_add=True)
    generated_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, blank=True, related_name="+",
    )
    approved_at = models.DateTimeField(null=True, blank=True)
    approved_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, blank=True, related_name="+",
    )
    # Set once this approval has been spent, so the History row and the
    # approval that authorised it can be read together.
    run = models.ForeignKey(
        "billing.RecurringBillingRun", on_delete=models.SET_NULL, null=True, blank=True,
        related_name="approvals",
    )

    class Meta:
        ordering = ["-created_at"]
        indexes = [models.Index(fields=["run_date", "approved_at"])]

    def __str__(self):
        return "Preview %s %s (%s)" % (self.run_date, self.fingerprint, "approved" if self.approved_at else "pending")

    @property
    def is_approved(self) -> bool:
        return self.approved_at is not None

    @property
    def is_spent(self) -> bool:
        return self.run_id is not None


class PaymentAllocation(models.Model):
    """Which invoice a slice of a payment settles.

    Payment.invoice already existed, but it is a single FK: one payment
    could only ever settle one invoice, and a bank-feed confirmation
    (which posts a customer and no invoice at all) settled none. A
    customer paying one round R2,000 against three outstanding invoices
    had no representable answer.

    Rows here move `Invoice.paid_amount` only. `Customer.balance` is moved
    exactly once, when the payment is recorded (PaymentSerializer.create),
    and allocation distributes money that balance has already accounted
    for. See billing/allocation.py -- anything here that touches balance
    is a double-count.

    Kept rather than folded into paid_amount so a mapping is auditable and
    reversible: who allocated what, when, and enough detail to undo one
    line without deleting and re-recording the payment.
    """

    payment = models.ForeignKey(
        "billing.Payment", on_delete=models.CASCADE, related_name="allocations"
    )
    # CASCADE, deliberately: if an invoice is deleted its allocations go
    # with it, and the money stays on the customer's balance as
    # unallocated credit -- which is the truthful outcome, since the debt
    # it was paying against no longer exists.
    invoice = models.ForeignKey(
        "billing.Invoice", on_delete=models.CASCADE, related_name="allocations"
    )
    amount = models.DecimalField(max_digits=12, decimal_places=2)
    created_at = models.DateTimeField(auto_now_add=True)
    created_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, blank=True, related_name="+"
    )

    class Meta:
        ordering = ["invoice__date_due", "pk"]
        constraints = [
            models.UniqueConstraint(
                fields=["payment", "invoice"], name="unique_payment_invoice_allocation"
            ),
        ]
        indexes = [models.Index(fields=["invoice"]), models.Index(fields=["payment"])]

    def __str__(self):
        return "R%s of payment %s -> %s" % (
            self.amount, self.payment_id, self.invoice.number if self.invoice_id else "?",
        )


class PublicHoliday(models.Model):
    """A day the platform will not disconnect anybody on.

    DATA RATHER THAN CODE, deliberately. South Africa's statutory list is
    stable but not fixed: election days get declared at short notice, the
    Public Holidays Act pushes a Sunday holiday onto the Monday, and a
    business may want its own December shutdown treated the same way.
    Something declared three weeks before it happens cannot be something
    that needs a deploy.

    Seeded by `manage.py seed_public_holidays`, and editable by hand
    afterwards -- the seed is a starting point, not the authority.

    ONLY SUSPENSION CONSULTS THIS. Invoices still go out on the 1st
    whatever day that is, because an invoice dated the 3rd for a period
    beginning the 1st is a bookkeeping problem, and nobody is harmed by an
    email arriving on a public holiday. Being disconnected on one is a
    different matter entirely -- see billing.business_days.
    """

    date = models.DateField(unique=True)
    name = models.CharField(max_length=120)
    #: Where the row came from. A seeded row can be regenerated; one
    #: somebody added by hand must never be overwritten by a re-seed.
    seeded = models.BooleanField(
        default=False,
        help_text="Created by seed_public_holidays. Rows added by hand stay untouched by a re-seed.",
    )
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["date"]
        verbose_name = "Public holiday"
        verbose_name_plural = "Public holidays"

    def __str__(self):
        return f"{self.date} {self.name}"
