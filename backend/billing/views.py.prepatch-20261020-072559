class PublicPaymentDetailsView(APIView):
    """Who to pay, and how. No login -- and that is the whole point.

    This feeds the /suspension page. A suspended PPPoE customer is inside
    the walled garden: DNS plus the portal host, nothing else. They have
    no session, and cannot get one, because "your account is unpaid" is
    not a state you can authenticate your way out of. So the page that
    tells them where to pay has to be readable with no credential at all.

    WHAT IT RETURNS IS A CLOSED LIST, written out field by field rather
    than through a serializer over BillingDefaults. That model is a
    singleton holding both the company's payment details AND the
    platform's billing behaviour -- blocking_period_days,
    minimum_balance, payment_due_days, the SARS VAT registration. A
    ModelSerializer here, or a `fields = "__all__"`, would publish the
    thresholds at which Skybre cuts customers off to anyone who typed the
    URL. Adding a field to BillingDefaults must not silently add it here,
    so the keys are enumerated and a test asserts the set.

    The bank account number IS published by this. That is a deliberate
    call: it is already printed on every invoice and statement the
    platform emails, and a payment page that hides the account number
    would have no reason to exist. If that trade stops being acceptable,
    clearing the banking fields in Configs -> Billing Defaults makes this
    return blanks and the page degrades to "contact accounts".

    Throttled by scope rather than left open: it is a cheap endpoint but
    an unauthenticated one, and there is no reason for a single client to
    fetch the same three constants more than a few times a minute.
    """

    permission_classes = [permissions.AllowAny]
    authentication_classes = []
    throttle_classes = [ScopedRateThrottle]
    throttle_scope = "public_payment_details"

    def get(self, request):
        from notifications.email_settings import get_email_config

        d = BillingDefaults.load()
        return Response({
            # The registered name is what appears on the bank's side as
            # the beneficiary, so it is the one a customer checks against
            # before releasing a payment. Falls back to the email
            # settings' brand name so the page is never unbranded.
            "company_name": d.company_legal_name or get_email_config()["company_name"],
            "phone": d.company_phone,
            "email": d.company_email,
            "bank_name": d.bank_name,
            "bank_account_number": d.bank_account_number,
            "bank_branch_code": d.bank_branch_code,
        })


