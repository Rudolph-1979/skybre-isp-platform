class RecurringBillingViewSet(viewsets.ViewSet):
    """Preview/Run actions for the recurring-billing engine -- Finance ->
    Recurring Billing's Preview/Run buttons. See
    billing.recurring.run_recurring_billing for the actual logic; this is
    just the thin HTTP wrapper around it."""

    permission_classes = [permissions.IsAuthenticated, IsStaffMember, HasFinanceAccess]

    def _parse_args(self, request):
        from datetime import date as date_cls
        run_date_str = request.data.get("date")
        if not run_date_str:
            raise ValueError("A date is required.")
        run_date = date_cls.fromisoformat(run_date_str)
        partner_ids = request.data.get("partners") or []
        return run_date, [int(p) for p in partner_ids]

    @action(detail=False, methods=["post"])
    def preview(self, request):
        """Projects the run, saves it as a reviewable snapshot, and returns
        the counts plus that snapshot. Writes a BillingPreviewSnapshot row
        and nothing else -- no invoice, no email, no RecurringBillingRun.

        The engine is also asked for its own counts and any disagreement is
        reported rather than swallowed: a preview finance cannot trust is
        worse than no preview, so a mismatch shows up in the UI instead of
        only in a test.
        """
        from .models import BillingPreviewSnapshot
        from .preview_export import build_csvs, project_run, projection_digest
        from .recurring import run_recurring_billing
        from .serializers import BillingPreviewSnapshotSerializer

        try:
            run_date, partner_ids = self._parse_args(request)
        except ValueError as exc:
            return Response({"detail": str(exc)}, status=400)

        projection = project_run(run_date, partner_ids=partner_ids or None)
        engine_counts = run_recurring_billing(run_date, partner_ids=partner_ids or None, commit=False)["counts"]

        snapshot = BillingPreviewSnapshot.objects.create(
            run_date=run_date,
            partner_ids=sorted(partner_ids or []),
            fingerprint=projection_digest(projection),
            engine=projection["engine"],
            counts=projection["counts"],
            grand_total=projection["grand_total"],
            sheets=build_csvs(projection),
            generated_by=request.user if request.user.is_authenticated else None,
        )
        body = {
            "counts": projection["counts"],
            "snapshot": BillingPreviewSnapshotSerializer(snapshot, context={"request": request}).data,
        }
        if engine_counts != projection["counts"]:
            body["mismatch"] = {"engine": engine_counts, "preview": projection["counts"]}
        return Response(body)

    @action(detail=False, methods=["get"])
    def previews(self, request):
        """Recent snapshots, newest first -- the approval queue.

        This exists because the review is not usually done by whoever
        clicked Preview: one person generates it, another opens this list,
        downloads the bundle and approves. Without it, a preview would only
        be reachable by the browser tab that created it.

        ?date=YYYY-MM-DD narrows to one billing date; ?pending=1 to the ones
        still waiting on someone.
        """
        from .models import BillingPreviewSnapshot
        from .serializers import BillingPreviewSnapshotSerializer

        queryset = BillingPreviewSnapshot.objects.select_related(
            "generated_by", "approved_by", "run"
        ).all()
        date_str = request.query_params.get("date")
        if date_str:
            from datetime import date as date_cls
            try:
                queryset = queryset.filter(run_date=date_cls.fromisoformat(date_str))
            except ValueError:
                return Response({"detail": "date must be YYYY-MM-DD."}, status=400)
        if request.query_params.get("pending"):
            queryset = queryset.filter(approved_at__isnull=True)
        serializer = BillingPreviewSnapshotSerializer(
            queryset[:20], many=True, context={"request": request}
        )
        return Response(serializer.data)

    @action(detail=True, methods=["get"])
    def export(self, request, pk=None):
        """The reviewed bundle for one snapshot, in whichever of three
        formats the caller asked for -- ?output=zip (default, the CSV
        bundle), html (a single printable page, opened inline rather than
        downloaded, so the frontend can pop it straight into a new tab) or
        xlsx (a single workbook, one tab per sheet). All three read the
        exact bytes that were reviewed (see preview_export's module note on
        why HTML/xlsx are built from the stored CSV text, never a fresh
        projection).

        The query param is named ?output=, not ?format= -- DRF reserves
        `format` for its own content-negotiation (a `?format=` it doesn't
        recognise as a registered renderer, such as html/xlsx, makes DRF
        itself 404 the request before this view ever runs)."""
        from django.http import HttpResponse
        from django.shortcuts import get_object_or_404

        from .models import BillingPreviewSnapshot
        from .preview_export import (
            build_html_from_snapshot, build_xlsx_from_snapshot, build_zip_from_snapshot,
        )

        snapshot = get_object_or_404(BillingPreviewSnapshot, pk=pk)
        fmt = (request.query_params.get("output") or "zip").lower()

        if fmt == "html":
            filename, text = build_html_from_snapshot(snapshot)
            response = HttpResponse(text, content_type="text/html; charset=utf-8")
            response["Content-Disposition"] = 'inline; filename="%s"' % filename
            return response

        if fmt == "xlsx":
            filename, blob = build_xlsx_from_snapshot(snapshot)
            response = HttpResponse(
                blob,
                content_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )
            response["Content-Disposition"] = 'attachment; filename="%s"' % filename
            response["Content-Length"] = str(len(blob))
            return response

        if fmt != "zip":
            return Response({"detail": "output must be one of: zip, html, xlsx."}, status=400)

        filename, blob = build_zip_from_snapshot(snapshot)
        response = HttpResponse(blob, content_type="application/zip")
        response["Content-Disposition"] = 'attachment; filename="%s"' % filename
        response["Content-Length"] = str(len(blob))
        return response

    @action(detail=True, methods=["post"])
    def approve(self, request, pk=None):
        """Signs off one snapshot so Run will accept it.

        Anyone with finance access can approve, including whoever generated
        it -- a two-person rule would stop a one-person finance team from
        billing at all. Both names are recorded in the snapshot and in the
        bundle's manifest, so the trail is there if you later want to
        require they differ (one condition, in this method).
        """
        from django.shortcuts import get_object_or_404
        from django.utils import timezone as dj_timezone

        from .models import BillingPreviewSnapshot
        from .serializers import BillingPreviewSnapshotSerializer

        snapshot = get_object_or_404(BillingPreviewSnapshot, pk=pk)
        if snapshot.is_spent:
            return Response(
                {"detail": "This preview has already been used for a billing run."}, status=409
            )
        if not snapshot.is_approved:
            snapshot.approved_at = dj_timezone.now()
            snapshot.approved_by = request.user if request.user.is_authenticated else None
            snapshot.save(update_fields=["approved_at", "approved_by"])
        return Response(BillingPreviewSnapshotSerializer(snapshot, context={"request": request}).data)

    def destroy(self, request, pk=None):
        """Throw away a preview nobody has approved. DELETE /recurring-billing/<id>/

        The approval queue fills up with attempts -- a wrong date, a partner
        scope picked by mistake, a re-preview after a tariff was corrected --
        and every one of them sits there looking like something waiting for a
        decision. Being able to clear the ones that are not is what keeps the
        list meaning "these need approving".

        UNAPPROVED ONLY, and that is the whole safety argument. An approved
        snapshot is a decision somebody signed off; deleting it would let one
        person silently undo another's approval with nothing anywhere to say
        it happened. A spent one is the audit trail of a run that really
        billed customers, which the model's own docstring says is kept
        deliberately. Both refuse with 409 and say why, rather than 403 --
        the caller has the right to be here, the object is in the wrong
        state.

        The row goes for good, including its stored CSV bundle. That is what
        was asked for, and it is defensible precisely because of the line
        above: nothing being deleted here was ever approved or acted on.
        """
        from django.shortcuts import get_object_or_404

        from .models import BillingPreviewSnapshot

        snapshot = get_object_or_404(BillingPreviewSnapshot, pk=pk)
        if snapshot.is_spent:
            return Response(
                {"detail": "This preview was used for a billing run and is part of its record."},
                status=409,
            )
        if snapshot.is_approved:
            return Response(
                {"detail": "This preview has been approved. Only previews still awaiting "
                           "approval can be deleted."},
                status=409,
            )
        snapshot.delete()
        return Response(status=204)

    @action(detail=False, methods=["post"])
    def run(self, request):
        """Commits a run -- but only what an approved preview accounted for.

        Two refusals, both 409 and both explaining themselves, because the
        alternative is a run whose invoices nobody signed off:
          * no approved snapshot for this date and partner scope
          * the approved snapshot's fingerprint no longer matches what this
            run would do, i.e. the data moved after approval
        """
        from django.utils import timezone as dj_timezone

        from .models import BillingPreviewSnapshot
        from .preview_export import project_run, projection_digest
        from .recurring import RecurringBillingBusy, run_recurring_billing
        from .serializers import RecurringBillingRunSerializer

        try:
            run_date, partner_ids = self._parse_args(request)
        except ValueError as exc:
            return Response({"detail": str(exc)}, status=400)

        # A future run date is refused here, BEFORE the approval lookup, and
        # the order is the point. run_recurring_billing raises on it too --
        # that is the authoritative rule and the management-command path needs
        # it -- but reaching it meant the approval check answered first, so
        # previewing a date a month out and pressing Run reported "no approved
        # preview" instead of the actual problem. The cheaper, more specific
        # rejection should win.
        if run_date > dj_timezone.localdate():
            return Response(
                {"detail": "%s is in the future, so this run is refused before the approval "
                           "lookup: a committed run applies every cancellation and tariff "
                           "change dated up to its run date, which would terminate services "
                           "and change plans early. Use a date up to %s."
                           % (run_date.isoformat(), dj_timezone.localdate().isoformat())},
                status=400,
            )

        scope = sorted(partner_ids or [])
        scope_label = ", ".join(str(p) for p in scope) if scope else "all partners"
        approved = (
            BillingPreviewSnapshot.objects.filter(
                run_date=run_date, partner_ids=scope, approved_at__isnull=False, run__isnull=True
            )
            .order_by("-approved_at")
            .first()
        )
        if approved is None:
            return Response(
                {"detail": "No approved preview for %s (%s). Preview it, have it approved, then run."
                           % (run_date.isoformat(), scope_label)},
                status=409,
            )

        current = projection_digest(project_run(run_date, partner_ids=partner_ids or None))
        if current != approved.fingerprint:
            return Response(
                {"detail": "The approved preview (%s) no longer matches what this run would do (%s) — "
                           "something changed since it was approved. Preview and approve again."
                           % (approved.fingerprint, current)},
                status=409,
            )

        try:
            result = run_recurring_billing(
                run_date, partner_ids=partner_ids or None, commit=True, triggered_by=request.user
            )
        except ValueError as exc:
            # A future run date. See run_recurring_billing.
            return Response({"detail": str(exc)}, status=400)
        except RecurringBillingBusy as exc:
            # 409, not 500: the request is well-formed, the server is just
            # already doing this. A second Run click is the ordinary way to
            # get here, so it needs to read as "wait", not "error".
            return Response({"detail": str(exc)}, status=status.HTTP_409_CONFLICT)

        # Spend the approval on the run it authorised, so History and the
        # sign-off that allowed it can be read together.
        approved.run = result["run"]
        approved.save(update_fields=["run"])
        return Response(RecurringBillingRunSerializer(result["run"]).data)

    @action(detail=False, methods=["post"], url_path="run-early")
    def run_early(self, request):
        """Issue the invoices for a billing date still to come, dated that
        date -- the Splynx way (preview ~24th, approve, issue). Invoices
        only; see billing.recurring._run_early for what it does and does
        not do. Needs the same approved preview as Run, and spends it."""
        from .recurring import EarlyInvoicingRefused, RecurringBillingBusy, run_recurring_billing
        from .serializers import RecurringBillingRunSerializer

        try:
            run_date, partner_ids = self._parse_args(request)
        except ValueError as exc:
            return Response({"detail": str(exc)}, status=400)
        try:
            result = run_recurring_billing(
                run_date, partner_ids=partner_ids or None, commit=True,
                triggered_by=request.user, early=True,
            )
        except ValueError as exc:
            return Response({"detail": str(exc)}, status=400)
        except (EarlyInvoicingRefused, RecurringBillingBusy) as exc:
            return Response({"detail": str(exc)}, status=status.HTTP_409_CONFLICT)
        return Response(RecurringBillingRunSerializer(result["run"]).data)


class PaymentViewSet(ScopedByCustomerMixin, viewsets.ModelViewSet):
    serializer_class = PaymentSerializer
    permission_classes = [permissions.IsAuthenticated]
    filterset_fields = ["method", "customer", "invoice"]
    ordering_fields = [
        "date",
        "customer__full_name",
        "amount",
        "method",
        "received_by__username",
    ]

    def get_queryset(self):
        # allocations prefetched for PaymentSerializer's allocated/unallocated
        # figures: one extra query for the page instead of two per row.
        return (
            self.get_base_queryset(Payment)
            .select_related("customer", "invoice")
            .prefetch_related("allocations")
        )

    def get_permissions(self):
        # HasFinanceAccess passes straight through for customers (section
        # restrictions are staff-only) so this only narrows list/retrieve
        # for staff who lack the Finance section, without touching what
        # customers can see of their own payments in the portal.
        if self.action in ("list", "retrieve"):
            return [permissions.IsAuthenticated(), HasFinanceAccess()]
        if self.action in ("destroy", "reverse"):
            # Taking money back off a customer is a finance decision:
            # Accounts, Management and Admin. Plain delete gets the same gate
            # as reverse so the Reverse button is not the only thing
            # standing between other staff roles and the API.
            return [permissions.IsAuthenticated(), IsAccountsOrManagement(), HasFinanceAccess()]
        return [permissions.IsAuthenticated(), IsStaffMember(), HasFinanceAccess()]

    def perform_destroy(self, instance):
        # Deleting a payment has to put the ledger back where it was --
        # see Payment.reverse_ledger_effect for what used to happen
        # instead. Both writes and the delete go in one transaction so a
        # failure can't leave the balance reversed with the payment still
        # on file, or vice versa.
        with transaction.atomic():
            instance.reverse_ledger_effect()
            instance.delete()

    @action(detail=True, methods=["post"])
    def reverse(self, request, pk=None):
        """Take a payment back off the customer it was recorded against,
        with a reason. Body: {"reason": "..."}.

        The same ledger reversal as delete (Payment.reverse_ledger_effect:
        balance back up, allocations and any direct invoice credit
        undone), in one transaction, plus two things delete does not do:
        the reason is required and goes onto the audit row, and the
        response says whether a bank-feed transaction went back to the
        review queue -- bankfeeds.signals reverts it to MATCHED, still on
        the old customer, so staff reassign and confirm it there.

        The payment row is locked and re-read inside the transaction, so a
        double-click or two people reversing at once gets one reversal and
        a 404, never the balance credited back twice.
        """
        from audit.context import deletion_detail

        reason = str(request.data.get("reason") or "").strip()
        if len(reason) < 5:
            return Response(
                {"detail": "Give a reason for reversing this payment (at least 5 characters)."},
                status=400,
            )

        payment = self.get_object()
        with transaction.atomic():
            locked = Payment.objects.select_for_update().filter(pk=payment.pk).first()
            if locked is None:
                return Response({"detail": "This payment has already been reversed."}, status=404)
            txn = getattr(locked, "bank_transaction", None)
            txn_id = txn.pk if txn is not None else None
            customer_name = locked.customer.full_name if locked.customer_id else ""
            amount = str(locked.amount)
            detail = f"Payment reversed (R {amount} from {customer_name}). Reason: {reason}"
            with deletion_detail(detail):
                locked.reverse_ledger_effect()
                locked.delete()

        return Response({
            "reversed": int(pk),
            "customer_name": customer_name,
            "amount": amount,
            "bank_transaction": txn_id,
        })

    @action(detail=False, methods=["get"], url_path="open-invoices")
    def open_invoices(self, request):
        """One customer's invoices with money still outstanding, oldest due
        first -- what the manual mapping screen lists to allocate against.

        Excludes quotes, pro formas, cancelled and draft invoices for the
        same reasons PaymentSerializer.validate refuses a payment against
        them: they are not debts.
        """
        from customers.models import Customer

        from .allocation import open_invoices as open_invoices_for

        customer_id = request.query_params.get("customer")
        if not customer_id:
            return Response({"detail": "A customer is required."}, status=400)
        try:
            customer = Customer.objects.get(pk=int(customer_id))
        except (ValueError, Customer.DoesNotExist):
            return Response({"detail": "No such customer."}, status=404)

        rows = [
            {
                "id": inv.pk,
                "number": inv.number,
                "status": inv.status,
                "date_due": inv.date_due,
                "total": str(inv.total),
                "paid_amount": str(inv.paid_amount),
                "balance_due": str(inv.balance_due),
            }
            for inv in open_invoices_for(customer)
        ]
        return Response({"customer": customer.pk, "balance": str(customer.balance), "invoices": rows})

    @action(detail=True, methods=["get", "post", "delete"])
    def allocations(self, request, pk=None):
        """Read, set or clear which invoices this payment settles.

        POST body:
          {"allocations": [{"invoice": 12, "amount": "435.85"}, ...]}
          {"auto": true}      -- fill oldest due first with what's left
          {"replace": true}   -- clear existing allocations first

        DELETE clears them all. Every path leaves Customer.balance alone:
        allocation only distributes money the payment already credited.
        """
        from .allocation import (
            AllocationError, allocate, auto_allocate, reverse_allocations, summarise,
        )

        payment = self.get_object()

        if request.method == "GET":
            return Response(summarise(payment))

        # A legacy payment recorded straight against an invoice (before
        # 5 Oct 2026) already credited that invoice without an allocation
        # row; allocating it again would put the same money on a second
        # invoice.
        if payment.invoice_id:
            return Response(
                {"detail": "This payment was recorded directly against an invoice and can't be re-allocated."},
                status=400,
            )

        if request.method == "DELETE":
            with transaction.atomic():
                reverse_allocations(payment)
            return Response(summarise(payment))

        try:
            with transaction.atomic():
                if request.data.get("replace"):
                    reverse_allocations(payment)
                if request.data.get("auto"):
                    auto_allocate(payment, user=request.user)
                else:
                    lines = request.data.get("allocations") or []
                    if not isinstance(lines, list):
                        return Response({"detail": "allocations must be a list."}, status=400)
                    pairs = []
                    for line in lines:
                        try:
                            pairs.append((line["invoice"], line["amount"]))
                        except (TypeError, KeyError):
                            return Response(
                                {"detail": "Each allocation needs an invoice and an amount."},
                                status=400,
                            )
                    if pairs:
                        allocate(payment, pairs, user=request.user)
        except AllocationError as exc:
            # 400 with the message as written: these are things the person
            # doing the mapping can fix (too much allocated, wrong
            # customer's invoice, nothing owed on it), not server faults.
            return Response({"detail": str(exc)}, status=400)

        payment.refresh_from_db()
        return Response(summarise(payment))


class _CreditAllocationsMixin:
    @action(detail=True, methods=["get", "post", "delete"])
    def allocations(self, request, pk=None):
        """Read, set or clear which invoices an approved credit settles --
        the credit counterpart of PaymentViewSet.allocations (5 Oct 2026).

        POST {"allocations": [{"invoice": 12, "amount": "80.00"}], "replace": true}
             {"auto": true, "replace": true}   -- oldest due first
        DELETE clears them (the credit then sits as account credit until the
        next invoice is raised). Customer.balance is never touched: the
        credit moved it once, on approval.
        """
        from .allocation import (
            AllocationError, allocate_credit, auto_allocate_credit, release_credit, summarise_credit,
        )

        credit = self.get_object()
        if request.method == "GET":
            return Response(summarise_credit(credit))
        if credit.status != CreditRequest.Status.APPROVED:
            return Response({"detail": "Only an approved credit can be allocated."}, status=400)
        if not credit.allocation_tracked:
            return Response(
                {"detail": "This credit was approved before allocations were recorded, so what it settled "
                           "can't be moved safely."},
                status=400,
            )
        # Validate the request body BEFORE touching anything, so a bad body
        # can never leave the credit's old allocations cleared.
        pairs = []
        if request.method == "POST" and not request.data.get("auto"):
            lines = request.data.get("allocations") or []
            if not isinstance(lines, list):
                return Response({"detail": "allocations must be a list."}, status=400)
            for line in lines:
                try:
                    pairs.append((int(line["invoice"]), line["amount"]))
                except (TypeError, KeyError, ValueError):
                    return Response({"detail": "Each allocation needs an invoice and an amount."}, status=400)
            if len({i for i, _ in pairs}) != len(pairs):
                return Response({"detail": "The same invoice appears twice."}, status=400)
        try:
            with transaction.atomic():
                if request.method == "DELETE" or request.data.get("replace"):
                    release_credit(credit)
                if request.method == "POST":
                    if request.data.get("auto"):
                        auto_allocate_credit(credit, user=request.user)
                    elif pairs:
                        allocate_credit(credit, pairs, user=request.user)
        except AllocationError as exc:
            return Response({"detail": str(exc)}, status=400)
        credit.refresh_from_db()
        return Response(summarise_credit(credit))


class CreditRequestViewSet(_CreditAllocationsMixin, viewsets.ModelViewSet):
    """Credit requests are a shared finance queue for Accounts/Management
    (and Admin) -- not scoped per-user like Leave requests, since it's a
    team workflow rather than personal HR data. Only Accounts can submit
    one; only Management can decide it."""

    serializer_class = CreditRequestSerializer
    queryset = CreditRequest.objects.select_related("customer", "requested_by", "decided_by").all()
    filterset_fields = ["customer", "status"]

    def get_queryset(self):
        # Partner-scoped like everything else that names a customer; a
        # credit request carries the customer's name and the amount.
        from customers.models import Customer
        from customers.views import scope_customers_to_user

        qs = super().get_queryset()
        user = self.request.user
        allowed = getattr(user, "allowed_partners", None) or []
        if not allowed or user.role == user.Role.ADMIN:
            return qs
        return qs.filter(customer__in=scope_customers_to_user(Customer.objects.all(), user))

    def get_permissions(self):
        if self.action in ("approve", "reject"):
            return [permissions.IsAuthenticated(), IsManagement(), HasFinanceAccess()]
        if self.action == "create":
            return [permissions.IsAuthenticated(), IsAccounts(), HasFinanceAccess()]
        return [permissions.IsAuthenticated(), IsAccountsOrManagement(), HasFinanceAccess()]

    def perform_create(self, serializer):
        serializer.save(requested_by=self.request.user)

    def perform_update(self, serializer):
        instance = serializer.instance
        user = self.request.user
        if instance.status != CreditRequest.Status.PENDING and user.role not in (
            user.Role.MANAGEMENT, user.Role.ADMIN,
        ):
            raise PermissionDenied("This credit request has already been decided and can no longer be edited.")
        serializer.save()

    def perform_destroy(self, instance):
        user = self.request.user
        if instance.status != CreditRequest.Status.PENDING and user.role not in (
            user.Role.MANAGEMENT, user.Role.ADMIN,
        ):
            raise PermissionDenied("This credit request has already been decided and can no longer be withdrawn.")
        instance.delete()

    @action(detail=True, methods=["post"])
    def approve(self, request, pk=None):
        """Credit the customer, once.

        This used to read the request, check it was Pending, write the
        balance and then write the decision -- four steps in autocommit
        with no row lock. Two Approve clicks 50 ms apart both passed the
        Pending check and both credited, so a R200 credit on a R1,000
        balance left R600. And if the decision save failed after the
        balance write, the customer kept the credit with the request still
        Pending, ready to be approved again.

        The request row is now locked for the duration and re-read inside
        the lock, so the second click finds it Approved and stops -- and
        the balance write uses F() rather than a read-modify-write, which
        is what let a concurrent payment lose a credit (or vice versa).
        bankfeeds.confirm() has used select_for_update for exactly this
        "double-clicked button could post the same money twice" hazard all
        along.

        Also creates the visible line item on the customer's Invoices tab
        (see CreditRequest.create_credit_note_invoice) -- inside the same
        atomic block, so an approval can never leave the balance moved
        with no invoice to show for it, or vice versa.
        """
        from django.db.models import F

        from customers.models import Customer

        with transaction.atomic():
            credit = CreditRequest.objects.select_for_update().get(pk=self.get_object().pk)
            if credit.status != CreditRequest.Status.PENDING:
                return Response({"detail": "This request has already been decided."}, status=400)

            Customer.objects.filter(pk=credit.customer_id).update(
                balance=F("balance") - credit.amount
            )
            credit.status = CreditRequest.Status.APPROVED
            credit.decided_by = request.user
            credit.decided_at = timezone.now()
            credit.create_credit_note_invoice()
            credit.save(update_fields=["status", "decided_by", "decided_at", "credit_note"])
            # What it settles (5 Oct 2026): its linked invoice first, the
            # rest oldest-first, recorded as CreditAllocation rows.
            from .allocation import allocate_approved_credit

            allocate_approved_credit(credit, user=request.user)

            # A credit can clear what got the customer suspended, exactly as
            # a payment can -- run the same reconnect check the Payment
            # signal runs (billing.reactivation.reconnect_customer), after
            # commit so it sees the new balance and settled invoice. Before
            # this, an approved credit left a customer off until the next
            # payment or the daily sweep, even with nothing left overdue.
            customer_id, credit_pk = credit.customer_id, credit.pk

            def _reconnect():
                import logging

                from .reactivation import reconnect_customer

                try:
                    reconnect_customer(customer_id, reason=f"credit #{credit_pk}")
                except Exception:
                    logging.getLogger(__name__).exception(
                        "Reconnection check after credit %s for customer %s failed",
                        credit_pk, customer_id,
                    )

            transaction.on_commit(_reconnect)

        credit.refresh_from_db()
        return Response(CreditRequestSerializer(credit).data)

    @action(detail=True, methods=["post"])
    def reject(self, request, pk=None):
        credit = self.get_object()
        if credit.status != CreditRequest.Status.PENDING:
            return Response({"detail": "This request has already been decided."}, status=400)
        credit.status = CreditRequest.Status.REJECTED
        credit.decision_note = request.data.get("decision_note", "")
        credit.decided_by = request.user
        credit.decided_at = timezone.now()
        credit.save(update_fields=["status", "decision_note", "decided_by", "decided_at"])
        return Response(CreditRequestSerializer(credit).data)


class UpcomingBlocksView(APIView):
    """GET /api/upcoming-blocks/?days=7

    Customers heading for an auto-suspension -- the dashboard's "Blocking
    tomorrow" tile and its drill-down list.

    The headline figure is TOMORROW (`count_tomorrow`); `results` covers the
    whole horizon so there is a chase window rather than a same-day surprise,
    with each customer's own block date and how many days away it is.

    Deliberately reports `auto_suspend_enabled` rather than being gated on
    it. The master switch (Configs -> Billing -> Auto-suspension) is off by
    default, and a panel that returned zero while it was off would be useless
    precisely when it matters most -- these are customers worth chasing
    whether or not the automation will actually cut them off. The frontend
    says plainly which it is.

    Uses billing.recurring.blocking_candidate_services' own predicate (via
    upcoming_blocks), so this cannot disagree with what a real billing run
    would do.

    Respects the same partner-visibility restriction as CustomerViewSet (see
    User.allowed_partners): a reseller-scoped staff member must not learn the
    names of customers outside their partners just because those customers
    turn up on a dashboard aggregate.
    """

    permission_classes = [permissions.IsAuthenticated, IsStaffMember, HasFinanceAccess]

    def get(self, request):
        from datetime import timedelta

        from django.db.models import Q as _Q

        from customers.models import Customer
        from .recurring import upcoming_blocks

        try:
            days = int(request.query_params.get("days", 7))
        except (TypeError, ValueError):
            return Response({"detail": "days must be a whole number."}, status=400)
        days = max(1, min(days, 60))

        # Mirror CustomerViewSet.get_queryset's partner scoping.
        user = request.user
        from customers.scoping import partner_condition

        visible = Customer.objects.all()
        condition = partner_condition(user)
        if condition is not None:
            visible = visible.filter(condition)

        tomorrow = timezone.localdate() + timedelta(days=1)
        results = upcoming_blocks(tomorrow, horizon_days=days, customers=visible)
        suspension_settings = SuspensionSettings.load()

        return Response({
            "from_date": tomorrow,
            "horizon_days": days,
            "auto_suspend_enabled": suspension_settings.auto_suspend_enabled,
            "count_tomorrow": sum(1 for r in results if r["days_until"] == 0),
            "count_horizon": len(results),
            "results": results,
        })


class FinanceDashboardView(ScopedByCustomerMixin, APIView):
    """GET /api/finance-dashboard/?partner=<id>

    Every figure on Finance -> Dashboard in one request. One call rather
    than eight, because each panel needs the same partner scoping applied
    the same way, and eight endpoints is eight chances for one of them to
    apply it slightly differently.

    Staff only, and Finance-section only. Partner visibility comes from
    ScopedByCustomerMixin, the same rule the Invoices and Payments tabs
    use -- a reseller-scoped staff member sees dashboard totals covering
    exactly the customers whose invoices they can already open, and no
    others. `?partner=` narrows further WITHIN what they may see; it can
    never widen it.
    """

    permission_classes = [permissions.IsAuthenticated, IsStaffMember, HasFinanceAccess]

    def get(self, request):
        from .dashboard import FinanceDashboard

        invoices = self.get_base_queryset(Invoice)
        payments = self.get_base_queryset(Payment)
        credits = self.get_base_queryset(CreditRequest)
        services = self.get_base_queryset(Service)

        # One partner or several: ?partner=1&partner=2 and ?partner=1,2 both
        # work, because a caller hand-building the URL will reach for one or
        # the other and neither is wrong.
        #
        # NO partners given means ALL of them -- the same "empty means
        # unrestricted" convention as User.allowed_partners and
        # Device.visible_partners. It also means the filter cannot be used to
        # arrive at "nothing selected, nothing shown", which reads as broken.
        raw = request.query_params.getlist("partner")
        partner_ids = []
        for value in raw:
            for part in str(value).split(","):
                part = part.strip()
                if not part:
                    continue
                try:
                    partner_ids.append(int(part))
                except ValueError:
                    return Response({"detail": "partner must be a whole number."}, status=400)

        if partner_ids:
            # Applied ON TOP of the scoped querysets above, never instead of
            # them, so asking for a partner you can't see returns nothing
            # rather than that partner's numbers.
            invoices = invoices.filter(customer__partner_id__in=partner_ids)
            payments = payments.filter(customer__partner_id__in=partner_ids)
            credits = credits.filter(customer__partner_id__in=partner_ids)
            services = services.filter(customer__partner_id__in=partner_ids)

        # Unrecognised values fall back to the default rather than erroring:
        # the period only widens or narrows a date window, so a typo showing
        # the month is a harmless outcome, and the response says which period
        # was actually used.
        period = (request.query_params.get("period") or "").strip().lower()

        data = FinanceDashboard(
            invoices=invoices,
            payments=payments,
            credits=credits,
            services=services,
            period=period,
        ).as_dict()
        data["partners"] = partner_ids
        return Response(data)
