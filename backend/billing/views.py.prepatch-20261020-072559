class TariffViewSet(CSVImportMixin, viewsets.ModelViewSet):
    serializer_class = TariffSerializer
    # Counted in SQL rather than per row: the tariff list shows how many
    # services each plan carries, and doing that with .services.count() would
    # be one extra query per tariff.
    # order_by is explicit because annotate() drops the model's Meta ordering,
    # and an unordered queryset makes pagination non-deterministic.
    queryset = Tariff.objects.annotate(
        service_count=Count("services", distinct=True),
        active_service_count=Count(
            "services", filter=Q(services__status=Service.Status.ACTIVE), distinct=True
        ),
    ).order_by("name")
    filterset_fields = ["service_type", "is_active", "partner"]
    search_fields = ["name"]
    ordering_fields = [
        "name", "service_type", "price", "billing_period",
        "speed_download_kbps", "tax_rate_pct", "is_active", "created_at", "cost_price",
    ]

    def get_queryset(self):
        """?for_customer=<id> narrows the list to plans that customer may
        actually be put on.

        The rule lives on the model (Tariff.available_to) and is applied
        here as its queryset equivalent, so the dropdown offers exactly
        what ServiceSerializer will accept. Expressed as a filter rather
        than by calling available_to() per row because this feeds a
        dropdown on a page with hundreds of tariffs.

        A tariff with NO partner is included for everyone, and a customer
        with NO partner sees everything -- "empty means unrestricted", the
        same convention as allowed_partners and visible_partners.

        An unknown customer id is ignored rather than returning nothing:
        the alternative is an empty dropdown with no explanation, and the
        serializer still refuses anything genuinely mismatched.
        """
        qs = super().get_queryset()
        for_customer = self.request.query_params.get("for_customer")
        if not for_customer:
            return qs
        from customers.models import Customer

        row = (
            Customer.objects.filter(pk=for_customer)
            .values_list("partner_id", "pending_partner_id")
            .first()
        )
        partner_id, pending_partner_id = row if row else (None, None)
        if partner_id is None:
            # Either no such customer, or a direct customer with no partner.
            # Both mean "do not narrow".
            return qs
        allowed = Q(partner_id=partner_id) | Q(partner__isnull=True)
        if pending_partner_id:
            # Booked to move partner (package #20): that partner's plans too,
            # for a service or plan change starting on/after the move --
            # ServiceSerializer enforces the date.
            allowed |= Q(partner_id=pending_partner_id)
        return qs.filter(allowed)

    def destroy(self, request, *args, **kwargs):
        """Delete a tariff, but only when nothing depends on it.

        Service.tariff is PROTECT, so without this the delete surfaces as a
        raw ProtectedError -- a 500, with no indication of which customers are
        in the way. And Service.pending_tariff is SET_NULL, which is worse
        than an error: deleting a tariff somebody has a change booked onto
        would silently null the tariff and leave the DATE behind, producing
        exactly the half-a-booking state the serializer refuses to let staff
        create.

        Deactivating is usually what's wanted anyway -- it takes the plan off
        the new-service dropdown while leaving every invoice that references
        it intact -- so the refusal says so.
        """
        tariff = self.get_object()

        in_use = tariff.services.count()
        booked = tariff.pending_services.count()
        if in_use or booked:
            parts = []
            if in_use:
                parts.append(f"{in_use} service{'s are' if in_use != 1 else ' is'} on it")
            if booked:
                parts.append(f"{booked} service{'s have' if booked != 1 else ' has'} a change booked onto it")
            return Response(
                {
                    "detail": (
                        f"Can't delete '{tariff.name}' — {' and '.join(parts)}. "
                        "Move those services to another plan first, or untick Active to take it "
                        "off the new-service list while leaving existing services and invoices alone."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )
        return super().destroy(request, *args, **kwargs)

    import_model = Tariff
    import_fields = {
        "name": {"required": True},
        "service_type": {
            "default": Tariff.ServiceType.INTERNET,
            "choices": Tariff.ServiceType.values,
        },
        "price": {"required": True, "type": "decimal"},
        "billing_period": {
            "default": Tariff.BillingPeriod.MONTHLY,
            "choices": Tariff.BillingPeriod.values,
        },
        "speed_download_kbps": {"type": "int", "default": None},
        "speed_upload_kbps": {"type": "int", "default": None},
        "data_cap_gb": {"type": "int", "default": None},
        "tax_rate_pct": {"type": "decimal", "default": Decimal("0")},
        "is_active": {"type": "bool", "default": True},
        "description": {"default": ""},
    }

    def get_permissions(self):
        # list/retrieve stay open to any staff member regardless of
        # Configs access -- Finance and Services both need to browse
        # tariffs to build invoice/quote line items and service plans.
        # Only actually creating/editing/deleting/importing tariffs
        # requires the Configs section itself.
        if self.action in ("list", "retrieve"):
            return [permissions.IsAuthenticated()]
        return [permissions.IsAuthenticated(), IsStaffMember(), HasConfigsAccess()]


class RecurringChargeViewSet(viewsets.ModelViewSet):
    """The catalog of standard recurring add-ons (IP Rental, Domain Rental,
    etc) staff can opt a service onto -- lives on its own tab of the
    Tariffs page (Rudolph, 30 Sep), same section/permission shape as
    Tariffs itself since it is the same kind of decision: what gets
    charged, and how much.
    """

    serializer_class = RecurringChargeSerializer
    queryset = RecurringCharge.objects.annotate(
        client_count=Count("customer_links__customer", distinct=True)
    ).order_by("name")
    filterset_fields = ["is_active", "partner"]
    search_fields = ["name"]
    ordering_fields = ["name", "price", "is_active", "created_at"]

    def get_queryset(self):
        """?for_customer=<id> narrows the list to charges that customer may
        actually be opted onto -- same reasoning, and the same query
        shape, as TariffViewSet.get_queryset above: the picker offers
        exactly what ServiceSerializer will accept."""
        qs = super().get_queryset()
        for_customer = self.request.query_params.get("for_customer")
        if not for_customer:
            return qs
        from customers.models import Customer

        row = Customer.objects.filter(pk=for_customer).values_list("partner_id", "pending_partner_id").first()
        partner_id, pending_partner_id = row if row else (None, None)
        if partner_id is None:
            return qs
        allowed = Q(partner_id=partner_id) | Q(partner__isnull=True)
        if pending_partner_id:
            allowed |= Q(partner_id=pending_partner_id)
        return qs.filter(allowed)

    def destroy(self, request, *args, **kwargs):
        """Refuse to delete a charge any client still carries (current or
        ended -- their history points at it) -- same reasoning as
        TariffViewSet.destroy. Untick Active to take it off the picker
        instead."""
        charge = self.get_object()
        in_use = charge.customer_links.values("customer").distinct().count()
        if in_use:
            return Response(
                {
                    "detail": (
                        f"Can't delete '{charge.name}' — {in_use} client{'s have' if in_use != 1 else ' has'} "
                        "it. Remove it from those clients first, or untick Active to take it "
                        "off the list without touching who's already carrying it."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )
        return super().destroy(request, *args, **kwargs)

    def get_permissions(self):
        # Same split as TariffViewSet: browsing (the Service edit picker,
        # for any staff editing a service) stays open; only managing the
        # catalog itself requires Configs.
        if self.action in ("list", "retrieve"):
            return [permissions.IsAuthenticated()]
        return [permissions.IsAuthenticated(), IsStaffMember(), HasConfigsAccess()]


