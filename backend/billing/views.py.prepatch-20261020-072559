class ServiceViewSet(ScopedByCustomerMixin, viewsets.ModelViewSet):
    serializer_class = ServiceSerializer
    permission_classes = [permissions.IsAuthenticated]
    filterset_fields = ["status", "customer"]
    # DRF's OrderingFilter only accepts real queryset lookups as values for
    # ?ordering= (a (field, label) tuple's second item is just a display
    # label, NOT an alias) — so these are Django's actual related-field
    # lookup paths, and the frontend must send exactly these strings.
    ordering_fields = [
        "customer__full_name",
        "tariff__name",
        "tariff__price",
        "status",
        "start_date",
        "end_date",
        "created_at",
    ]

    def get_queryset(self):
        from django.db.models import Prefetch

        from radiusauth.models import RadiusAction

        return (
            self.get_base_queryset(Service)
            .select_related("tariff", "customer", "customer__partner", "partner")
            # Only the newest enforcement attempt is shown per service, but a
            # Prefetch queryset can't be sliced, so the ordering is set here
            # and the serializer takes the first. Without this it is one query
            # per service on a page whose whole job is listing them.
            .prefetch_related(
                Prefetch(
                    "radius_actions",
                    queryset=RadiusAction.objects.order_by("-created_at"),
                    to_attr="recent_radius_actions",
                ),
                # The booked cancellation shown on the row (#203).
                Prefetch(
                    "cancellations",
                    queryset=ServiceCancellation.objects.filter(status=ServiceCancellation.Status.ACTIVE)
                    .select_related("replacement_service__tariff", "created_by")
                    .prefetch_related("credit_requests__invoice"),
                    to_attr="active_cancellations",
                ),
            )
        )

    def get_serializer(self, *args, **kwargs):
        """Adds each line's online state (radiusauth.offline.
        service_connection_state), built once for the whole page."""
        if args and args[0] is not None:
            from radiusauth.offline import service_connection_state

            instances = args[0]
            if kwargs.get("many"):
                instances = list(instances)
                args = (instances,) + args[1:]
                rows = instances
            else:
                rows = [instances]
            context = kwargs.setdefault("context", self.get_serializer_context())
            try:
                context["service_connection_map"] = service_connection_state(rows)
            except Exception:  # noqa: BLE001 -- a radacct hiccup must not take the list down
                context["service_connection_map"] = {}
        return super().get_serializer(*args, **kwargs)

    def get_permissions(self):
        # HasServicesAccess passes straight through for customers (section
        # restrictions are staff-only) so this only narrows list/retrieve
        # for staff who lack the Services section, without touching what
        # customers can see of their own services in the portal.
        if self.action in ("list", "retrieve"):
            return [permissions.IsAuthenticated(), HasServicesAccess()]
        if self.action == "live_bandwidth":
            return [permissions.IsAuthenticated(), HasServicesAccess()]
        if self.action in ("cancel", "withdraw_cancellation"):
            # Rudolph 20 Oct 2026: Admin / Management only.
            return [permissions.IsAuthenticated(), IsManagement(), HasServicesAccess()]
        return [permissions.IsAuthenticated(), IsStaffMember(), HasServicesAccess()]

    @action(detail=True, methods=["post"])
    def cancel(self, request, pk=None):
        """Cancel this service (#203; billing.service_cancel). Without
        `commit` it only works out the end date and any pro rata credit;
        `commit=1` books it. Fields: kind ("notice" | "cannot_service"),
        notice_date, end_date, replacement_service, reason."""
        import datetime as _dt

        from . import service_cancel as sc

        service = self.get_object()
        data = request.data

        def day(name):
            value = (data.get(name) or "").strip() if isinstance(data.get(name), str) else data.get(name)
            if not value:
                return None
            try:
                return _dt.date.fromisoformat(str(value))
            except ValueError:
                raise ValidationError({name: "Use a date like 2026-10-20."})

        replacement = None
        if data.get("replacement_service"):
            replacement = Service.objects.filter(pk=data.get("replacement_service")).select_related("tariff").first()
            if replacement is None:
                raise ValidationError({"replacement_service": "That service doesn't exist."})
        try:
            result = sc.plan(
                service, data.get("kind") or "",
                notice_date=day("notice_date"), end_date=day("end_date"), replacement=replacement,
            )
            body = sc.result_json(result, service)
            if str(data.get("commit") or "").lower() in ("1", "true", "yes"):
                cancellation = sc.commit(service, result, data.get("reason"), request.user)
                body["cancellation"] = cancellation.pk
                body["committed"] = True
                return Response(body, status=status.HTTP_201_CREATED)
        except sc.CancelError as exc:
            return Response({"detail": str(exc)}, status=400)
        body["committed"] = False
        return Response(body)

    @action(detail=True, methods=["post"], url_path="withdraw-cancellation")
    def withdraw_cancellation(self, request, pk=None):
        from . import service_cancel as sc

        service = self.get_object()
        cancellation = service.cancellations.filter(status=ServiceCancellation.Status.ACTIVE).first()
        if cancellation is None:
            return Response({"detail": "This service has no cancellation booked."}, status=400)
        try:
            sc.withdraw(cancellation, request.user)
        except sc.CancelError as exc:
            return Response({"detail": str(exc)}, status=400)
        return Response({"withdrawn": cancellation.pk, "end_date": service.end_date})

    @action(detail=True, methods=["get"], url_path="live-bandwidth")
    def live_bandwidth(self, request, pk=None):
        """Live download/upload speed for this one service, read from its
        managed Simple Queue on its device (see network.mikrotik's
        get_service_live_bandwidth). Meant to be polled by a customer's
        Service/Customer detail page ONLY while a staff member actually has
        it open -- the frontend is responsible for stopping the polling
        interval on unmount so this stops being called the moment nobody's
        watching. A per-device lock (network.mikrotik.get_device_lock)
        makes sure concurrent polls for the same device's customers queue
        onto one RouterOS connection at a time rather than each opening
        their own."""
        service = self.get_object()
        if not service.device_id:
            return Response({"detail": "This service isn't assigned to a router."}, status=400)
        device = service.device
        if not device.api_enabled:
            return Response({"detail": "This service's router doesn't have the Mikrotik API enabled."}, status=400)

        lock = mikrotik.get_device_lock(device.id)
        with lock:
            try:
                result = mikrotik.get_service_live_bandwidth(device, service.id)
            except mikrotik.MikrotikError as exc:
                return Response({"detail": str(exc)}, status=502)

        if result is None:
            return Response(
                {"detail": "No live queue found for this service yet -- enable Shaper on its router and sync shaper queues."},
                status=404,
            )
        return Response(result)


class InvoiceViewSet(ScopedByCustomerMixin, viewsets.ModelViewSet):
    permission_classes = [permissions.IsAuthenticated]
    filterset_class = InvoiceFilter
    ordering_fields = [
        "number",
        "customer__full_name",
        "status",
        "date_created",
        "date_due",
        "subtotal",
        "tax_total",
        "total",
        "paid_amount",
    ]

    def get_serializer_class(self):
        if self.action == "create":
            return InvoiceCreateSerializer
        return InvoiceSerializer

    def get_queryset(self):
        from django.db.models import OuterRef, Subquery

        from notifications.models import EmailLog

        # When this document was last emailed, and to whom (7 Oct 2026) --
        # for the Send / Resend buttons.
        sent = EmailLog.objects.filter(invoice=OuterRef("pk"), status=EmailLog.Status.SENT).order_by("-created_at")
        return (
            self.get_base_queryset(Invoice).prefetch_related("items").select_related("customer")
            .annotate(last_emailed_at=Subquery(sent.values("created_at")[:1]),
                      last_emailed_to=Subquery(sent.values("recipient_email")[:1]))
        )

    @action(detail=True, methods=["post"])
    def send(self, request, pk=None):
        """Email this invoice / quote / pro forma to the client now, with its
        PDF -- the same email and PDF the billing run sends (7 Oct 2026:
        "Nowhere is there an option to send or resend invoices"). Goes to
        the billing email with the main email in CC, as always."""
        from notifications.models import EmailLog, EmailTemplate
        from notifications.services import send_customer_email

        invoice = self.get_object()
        if invoice.status in (Invoice.Status.DRAFT, Invoice.Status.CANCELLED):
            return Response({"detail": f"A {invoice.get_status_display().lower()} document can't be sent."},
                            status=status.HTTP_400_BAD_REQUEST)
        key = {
            Invoice.Status.QUOTE: EmailTemplate.Key.QUOTE,
            Invoice.Status.PROFORMA: EmailTemplate.Key.PROFORMA,
        }.get(invoice.status, EmailTemplate.Key.INVOICE)
        log = send_customer_email(key, invoice.customer, sent_by_id=request.user.id, invoice=invoice)
        if log.status != EmailLog.Status.SENT:
            return Response({"detail": f"The email didn't go: {log.error_message or 'unknown error'}"},
                            status=status.HTTP_502_BAD_GATEWAY)
        return Response({"sent_to": log.recipient_email, "cc": log.cc_email, "sent_at": log.created_at})

    def get_permissions(self):
        # HasFinanceAccess passes straight through for customers (section
        # restrictions are staff-only) so this only narrows list/retrieve
        # for staff who lack the Finance section, without touching what
        # customers can see of their own invoices in the portal.
        if self.action in ("list", "retrieve"):
            return [permissions.IsAuthenticated(), HasFinanceAccess()]
        return [permissions.IsAuthenticated(), IsStaffMember(), HasFinanceAccess()]

    # --- Export what is on screen ----------------------------------------
    #
    # Runs the SAME filter_queryset the list does, so the file contains
    # exactly what the page is showing -- every matching document, not the
    # hundred currently rendered. An export that quietly disagrees with the
    # screen above it is worse than no export, because nobody re-checks a
    # spreadsheet against the UI.
    #
    # Server-side rather than built in the browser for the same reason:
    # once two years of history is imported for the whole book, the browser
    # only ever holds one page of it.
    #
    # Amounts are written as plain numbers, no "R" and no thousands
    # separator, because this is going into a spreadsheet to be worked on.
    # Excl/VAT/Incl are all three present: `total` is the VAT-INCLUSIVE
    # figure and the one most people want, with the split beside it for
    # whoever is doing the VAT return.
    @action(detail=False, methods=["get"], url_path="export-csv")
    def export_csv(self, request):
        import csv as _csv
        from django.http import StreamingHttpResponse

        queryset = self.filter_queryset(self.get_queryset()).order_by(
            request.query_params.get("ordering") or "-date_created"
        )

        class _Echo:
            """Write-only file-like, so rows stream instead of being built
            into one string in memory."""

            def write(self, value):
                return value

        writer = _csv.writer(_Echo())
        columns = [
            "Number", "Customer", "Reference", "Document date", "Due date", "Status",
            "Excl VAT", "VAT", "Incl VAT", "Paid", "Balance",
        ]

        def rows():
            yield writer.writerow(columns)
            for invoice in queryset.iterator(chunk_size=500):
                balance = (invoice.total or 0) - (invoice.paid_amount or 0)
                yield writer.writerow([
                    invoice.number,
                    invoice.customer.full_name if invoice.customer_id else "",
                    invoice.customer.customer_id if invoice.customer_id else "",
                    invoice.date_issued or invoice.date_created or "",
                    invoice.date_due or "",
                    invoice.get_status_display(),
                    invoice.subtotal,
                    invoice.tax_total,
                    invoice.total,
                    invoice.paid_amount,
                    balance,
                ])

        stamp = timezone.localdate().isoformat()
        response = StreamingHttpResponse(rows(), content_type="text/csv")
        response["Content-Disposition"] = f'attachment; filename="invoices_{stamp}.csv"'
        return response

    @action(detail=True, methods=["post"], url_path="convert-to-proforma")
    def convert_to_proforma(self, request, pk=None):
        """Quote -> Pro Forma. One-directional -- see Invoice.convert_to_proforma()."""
        invoice = self.get_object()
        try:
            invoice.convert_to_proforma()
        except ValueError as exc:
            return Response({"detail": str(exc)}, status=status.HTTP_400_BAD_REQUEST)
        return Response(InvoiceSerializer(invoice, context=self.get_serializer_context()).data)

    @action(detail=True, methods=["post"], url_path="convert-to-invoice")
    def convert_to_invoice(self, request, pk=None):
        """Quote -> Invoice or Pro Forma -> Invoice -- see Invoice.convert_to_invoice()."""
        invoice = self.get_object()
        try:
            invoice.convert_to_invoice()
        except ValueError as exc:
            return Response({"detail": str(exc)}, status=status.HTTP_400_BAD_REQUEST)
        return Response(InvoiceSerializer(invoice, context=self.get_serializer_context()).data)

    def destroy(self, request, *args, **kwargs):
        # Quotes and pro forma invoices need Management approval to delete
        # -- same trust tier as deleting a Customer. The only path is
        # InvoiceDeletionRequestViewSet.approve, which only Management/
        # Admin can call. See that viewset below. Real invoices
        # (draft/unpaid/paid/overdue/cancelled) are untouched by this --
        # still directly deletable by staff with Finance access, same as
        # before this feature.
        instance = self.get_object()
        if instance.status in Invoice.PRE_INVOICE_STATUSES:
            raise MethodNotAllowed(
                "DELETE",
                detail=(
                    "Quotes and pro forma invoices can't be deleted directly -- submit a deletion request "
                    "(POST /invoice-deletion-requests/) for Management to approve."
                ),
            )
        # An invoice with money against it cannot be deleted. Payment.invoice
        # is SET_NULL, so the payment rows survive the delete with their
        # credit still applied to the balance -- while releasing the
        # invoice's debit removes the other side of it. The customer is
        # left in credit by whatever they paid, with no invoice on file to
        # explain it: exactly the phantom-credit state this whole change
        # set out to eliminate, and it flips
        # blocking_candidate_services' `balance <= minimum_balance` test
        # so the line can never be suspended again.
        #
        # Refusing is deliberate rather than unwinding the payments
        # automatically. Whether that money is a refund owed, a credit to
        # carry, or a capture against the wrong invoice is a finance
        # decision, and reversing a real receipt silently is not this
        # endpoint's call to make. Payments are now reversible on their
        # own (see Payment.reverse_ledger_effect), so the route is:
        # reverse the payments, then delete.
        paid = instance.payments.count()
        # Since 5 Oct 2026 money reaches an invoice as allocations (payment
        # or credit), not only as a direct Payment.invoice -- the same rule
        # applies to them: cancel the invoice instead (its money then moves
        # to the client's next invoice), or take the allocation off first.
        allocated = (
            (instance.allocations.aggregate(total=Sum("amount"))["total"] or 0)
            + (instance.credit_allocations.aggregate(total=Sum("amount"))["total"] or 0)
        )
        if allocated and not paid:
            n_pay = instance.allocations.values("payment").distinct().count()
            n_cred = instance.credit_allocations.values("credit").distinct().count()
            parts = []
            if n_pay:
                parts.append(f"{n_pay} payment{'s' if n_pay != 1 else ''}")
            if n_cred:
                parts.append(f"{n_cred} credit{'s' if n_cred != 1 else ''}")
            raise ValidationError({
                "detail": (
                    f"{instance.number} has {' and '.join(parts)} allocated to it totalling R{allocated:.2f}. "
                    "Cancel it instead -- its money then moves to the client's next open invoice. "
                    "Reverse the payment, or remove the allocation on the Finance page, to delete it."
                )
            })
        if paid:
            total_paid = instance.payments.aggregate(total=Sum("amount"))["total"] or 0
            raise ValidationError({
                "detail": (
                    f"{instance.number} has {paid} payment{'s' if paid != 1 else ''} against it "
                    f"totalling {total_paid}. Deleting it would leave that money on the customer's "
                    "account as credit with no invoice to explain it. Reverse the payment"
                    f"{'s' if paid != 1 else ''} on the Finance page first, then delete the invoice."
                )
            })

        # Take the invoice's debit back off the customer's balance before
        # the row goes. Deleting an invoice used to leave the debit behind
        # with nothing left to explain it, so the customer was chased for
        # -- and eventually suspended over -- money no invoice claimed.
        # One transaction, so the balance and the row move together.
        with transaction.atomic():
            # A credit note from an approved credit: deleting it undoes the
            # credit (balance back up, what it settled back to owing, the
            # request marked Reversed) rather than just removing the
            # document and leaving the money moved. Rudolph, 1 Oct: reverse
            # fully. A credit note's own balance_debited is always None, so
            # release_balance_debit below is a no-op for it.
            credit = CreditRequest.objects.select_for_update().filter(credit_note=instance).first()
            if credit is not None and credit.status == CreditRequest.Status.APPROVED:
                who = getattr(request.user, "username", "") or "staff"
                credit.reverse(note=f"Reversed: credit note {instance.number} deleted by {who}")
            instance.release_balance_debit()
            # Payment/credit allocations on this invoice go with it
            # (CASCADE); that money is free again, so let it settle the
            # client's other open invoices once this commits.
            from .allocation import sweep_after_commit

            sweep_after_commit(instance.customer_id)
            return super().destroy(request, *args, **kwargs)


class InvoiceDeletionRequestViewSet(viewsets.ModelViewSet):
    """The only path by which a Quote or Pro Forma Invoice actually gets
    deleted -- see InvoiceViewSet.destroy above. Any staff member with
    Finance access can submit one; only Management (or Admin) can approve
    or reject it. Mirrors customers.CustomerDeletionRequestViewSet."""

    serializer_class = InvoiceDeletionRequestSerializer
    filterset_fields = ["invoice", "status"]

    def get_queryset(self):
        # Scoped through the invoice to its customer, the same rule
        # ScopedByCustomerMixin applies to the invoices themselves. This
        # was a flat .all(): the requests carry the invoice number, the
        # customer's name and the requester's reason, so a
        # reseller-restricted Management account could read another
        # partner's pending deletions -- and, since approve()/reject()
        # resolve through get_object() on this same queryset, approve the
        # destruction of a competitor's quote. The invoices themselves
        # were already scoped, so this was the one way round it.
        #
        # allow_null=False: a request whose invoice has gone (the FK is
        # nullable, and approve() handles that case) has no customer to
        # scope by, so a restricted user should not see it.
        from customers.scoping import scope_by_customer

        return scope_by_customer(
            InvoiceDeletionRequest.objects.select_related(
                "invoice", "invoice__customer", "requested_by", "decided_by"
            ).all(),
            self.request.user,
            path="invoice__customer",
            allow_null=False,
        )

    def get_permissions(self):
        if self.action in ("approve", "reject"):
            return [permissions.IsAuthenticated(), IsManagement(), HasFinanceAccess()]
        return [permissions.IsAuthenticated(), IsStaffMember(), HasFinanceAccess()]

    def perform_create(self, serializer):
        serializer.save(requested_by=self.request.user)

    def perform_destroy(self, instance):
        # "Withdrawing" your own still-pending request -- once decided,
        # it's a permanent record (same convention as CustomerDeletionRequest).
        user = self.request.user
        if instance.status != InvoiceDeletionRequest.Status.PENDING and user.role not in (
            user.Role.MANAGEMENT, user.Role.ADMIN,
        ):
            raise MethodNotAllowed(
                "DELETE", detail="This request has already been decided and can no longer be withdrawn."
            )
        instance.delete()

    @action(detail=True, methods=["post"])
    def approve(self, request, pk=None):
        deletion_request = self.get_object()
        if deletion_request.status != InvoiceDeletionRequest.Status.PENDING:
            return Response({"detail": "This request has already been decided."}, status=400)
        invoice = deletion_request.invoice
        if invoice is None:
            return Response({"detail": "This quote/pro forma invoice no longer exists."}, status=400)

        deletion_request.status = InvoiceDeletionRequest.Status.APPROVED
        deletion_request.decided_by = request.user
        deletion_request.decided_at = timezone.now()
        deletion_request.save(update_fields=["status", "decided_by", "decided_at"])

        # A quote/pro forma carries no balance debit, so this is a no-op
        # today -- called anyway so the invariant "nothing is deleted
        # without releasing its debit" holds at every delete site rather
        # than depending on which statuses reach this one.
        invoice.release_balance_debit()
        invoice.delete()

        return Response(InvoiceDeletionRequestSerializer(deletion_request).data)

    @action(detail=True, methods=["post"])
    def reject(self, request, pk=None):
        deletion_request = self.get_object()
        if deletion_request.status != InvoiceDeletionRequest.Status.PENDING:
            return Response({"detail": "This request has already been decided."}, status=400)
        deletion_request.status = InvoiceDeletionRequest.Status.REJECTED
        deletion_request.decision_note = request.data.get("decision_note", "")
        deletion_request.decided_by = request.user
        deletion_request.decided_at = timezone.now()
        deletion_request.save(update_fields=["status", "decision_note", "decided_by", "decided_at"])
        return Response(InvoiceDeletionRequestSerializer(deletion_request).data)


class SuspensionExtensionRequestViewSet(viewsets.ModelViewSet):
    """A request to pause suspension and the reminder/warning chasers for
    a customer until a given date -- same trust tier as CreditRequest and
    InvoiceDeletionRequest: any staff member with Finance access can
    submit one, only Management (or Admin) can approve or reject it.
    Approving writes CustomerBillingConfig.suspension_extended_until,
    which billing.recurring checks in three places -- see that module."""

    serializer_class = SuspensionExtensionRequestSerializer
    filterset_fields = ["customer", "status"]

    def get_queryset(self):
        from customers.models import Customer
        from customers.views import scope_customers_to_user

        qs = SuspensionExtensionRequest.objects.select_related("customer", "requested_by", "decided_by").all()
        user = self.request.user
        allowed = getattr(user, "allowed_partners", None) or []
        if not allowed or user.role == user.Role.ADMIN:
            return qs
        return qs.filter(customer__in=scope_customers_to_user(Customer.objects.all(), user))

    def get_permissions(self):
        if self.action in ("approve", "reject"):
            return [permissions.IsAuthenticated(), IsManagement(), HasFinanceAccess()]
        return [permissions.IsAuthenticated(), IsStaffMember(), HasFinanceAccess()]

    def perform_create(self, serializer):
        serializer.save(requested_by=self.request.user)

    def perform_destroy(self, instance):
        # "Withdrawing" your own still-pending request -- once decided,
        # it's a permanent record (same convention as InvoiceDeletionRequest).
        user = self.request.user
        if instance.status != SuspensionExtensionRequest.Status.PENDING and user.role not in (
            user.Role.MANAGEMENT, user.Role.ADMIN,
        ):
            raise MethodNotAllowed(
                "DELETE", detail="This request has already been decided and can no longer be withdrawn."
            )
        instance.delete()

    @action(detail=True, methods=["post"])
    def approve(self, request, pk=None):
        """Locked and re-read inside the transaction, same double-click
        guard as CreditRequest.approve -- two Approve clicks on the same
        request must write the config once, not twice."""
        with transaction.atomic():
            ext = SuspensionExtensionRequest.objects.select_for_update().get(pk=self.get_object().pk)
            if ext.status != SuspensionExtensionRequest.Status.PENDING:
                return Response({"detail": "This request has already been decided."}, status=400)

            config = CustomerBillingConfig.for_customer(ext.customer)
            config.suspension_extended_until = ext.extend_until
            config.save(update_fields=["suspension_extended_until"])

            ext.status = SuspensionExtensionRequest.Status.APPROVED
            ext.decided_by = request.user
            ext.decided_at = timezone.now()
            ext.save(update_fields=["status", "decided_by", "decided_at"])

        ext.refresh_from_db()
        return Response(SuspensionExtensionRequestSerializer(ext).data)

    @action(detail=True, methods=["post"])
    def reject(self, request, pk=None):
        ext = self.get_object()
        if ext.status != SuspensionExtensionRequest.Status.PENDING:
            return Response({"detail": "This request has already been decided."}, status=400)
        ext.status = SuspensionExtensionRequest.Status.REJECTED
        ext.decision_note = request.data.get("decision_note", "")
        ext.decided_by = request.user
        ext.decided_at = timezone.now()
        ext.save(update_fields=["status", "decision_note", "decided_by", "decided_at"])
        return Response(SuspensionExtensionRequestSerializer(ext).data)


class PaymentMethodViewSet(viewsets.ModelViewSet):
    """Config-managed lookup of payment conventions (see PaymentMethod's
    docstring) -- any staff with Finance access can view them (needed for
    the billing-config dropdowns), but only Admin can add/edit/remove one,
    same trust tier as Email/OVPN settings."""

    serializer_class = PaymentMethodSerializer
    queryset = PaymentMethod.objects.all()
    filterset_fields = ["is_active"]

    def get_permissions(self):
        if self.action in ("list", "retrieve"):
            return [permissions.IsAuthenticated(), IsStaffMember(), HasFinanceAccess()]
        return [permissions.IsAuthenticated(), IsAdmin(), HasFinanceAccess()]

    @action(detail=True, methods=["post"], url_path="apply-to-existing")
    def apply_to_existing(self, request, pk=None):
        """Copy this method's terms onto every customer already on it.

        POST {"commit": false} previews; {"commit": true} writes.

        The preview exists because this endpoint can suspend people.
        Shortening blocking_period_days and applying it doesn't fail or
        warn -- it just means the next billing run, which is minutes away,
        finds customers who are now past their (new, shorter) grace period
        and cuts them off. "340 customers updated" tells you nothing about
        that. So both passes run the real
        recurring.blocking_candidate_services against each customer,
        before and after the new terms, and report who crosses from safe
        to blocked.

        The preview pass mutates each config in memory and never saves it,
        so a preview cannot write anything even if it raises partway.
        """
        method = self.get_object()
        commit = bool(request.data.get("commit"))
        run_date = timezone.localdate()

        configs = (
            CustomerBillingConfig.objects
            .filter(payment_method=method)
            .select_related("customer")
        )

        affected, newly_blocked = 0, []
        for config in configs:
            customer = config.customer
            was_blocked = bool(blocking_candidate_services(customer, config, run_date))

            for field in PaymentTermsMixin.TERMS_FIELDS:
                setattr(config, field, getattr(method, field))

            now_blocked = blocking_candidate_services(customer, config, run_date)
            affected += 1
            if now_blocked and not was_blocked:
                newly_blocked.append({
                    "customer_id": customer.pk,
                    "customer": customer.full_name,
                    "reference": customer.customer_id,
                    "services": len(now_blocked),
                })

            if commit:
                config.save()

        return Response({
            "committed": commit,
            "customers": affected,
            "newly_blocked": newly_blocked,
            # blocking_candidate_services deliberately ignores the global
            # master switch, so say plainly whether any of this would
            # actually happen. "12 customers would be blocked" reads very
            # differently when auto-suspension is switched off entirely.
            "auto_suspend_enabled": SuspensionSettings.load().auto_suspend_enabled,
        })


