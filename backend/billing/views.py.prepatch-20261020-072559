def _uplift_note(customer, line, run_date, charge_notes=None):
    if line.get("type") == "recurring_charge":
        # Recurring services come in billable order; a positive line is the
        # charge itself (its discount line, if any, is negative).
        if charge_notes and Decimal(line["unit_price"]) > 0:
            return charge_notes.pop(0)
        return ""
    sid = line.get("service_id")
    if not sid or Decimal(line["unit_price"]) <= 0:
        return ""
    service = customer.services.select_related("tariff").filter(pk=sid).first()
    if service is None:
        return ""
    up = service.surcharge_amount_for(run_date)
    if not up or Decimal(line["unit_price"]) != service.billed_price(run_date, base_price=line["unit_price"] - up):
        return ""
    return f"Includes R{up:.2f} excl. VAT Rand amount up (list R{Decimal(line['unit_price']) - up:.2f}) — office only"


class CustomerInvoicePreviewView(APIView):
    """GET /api/customer-billing-config/<customer_id>/invoice-preview/?date=YYYY-MM-DD

    The recurring invoice this client would get on `date` (default: their
    next billing date, else today), worked out by the SAME code the billing
    run and Finance's preview use (preview_export._project_invoice ->
    invoice_lines), so it shows discounts, "Rand amount up" special pricing
    and recurring charges exactly as they will bill. Writes nothing
    (George, 13 Oct 2026: "Add a Preview invoice option")."""

    permission_classes = [permissions.IsAuthenticated, IsStaffMember, HasFinanceAccess]

    def get(self, request, customer_id):
        import datetime

        from customers.models import Customer
        from customers.views import scope_customers_to_user

        from .preview_export import _project_invoice

        customer = get_object_or_404(scope_customers_to_user(Customer.objects.all(), request.user), pk=customer_id)
        config = CustomerBillingConfig.for_customer(customer)
        raw = (request.query_params.get("date") or "").strip()
        if raw:
            try:
                run_date = datetime.date.fromisoformat(raw)
            except ValueError:
                return Response({"detail": "date must be YYYY-MM-DD."}, status=400)
        else:
            run_date = config.next_billing_date or timezone.localdate()
        doc = _project_invoice(customer, config, run_date)
        from .invoice_lines import billable_customer_charges

        charge_notes = []
        for link in billable_customer_charges(customer, run_date):
            up = link.surcharge_amount_for(run_date)
            charge_notes.append(
                f"Includes R{up:.2f} excl. VAT Rand amount up (list R{link.base_total():.2f}) — office only" if up else ""
            )
        out = {
            "date": run_date.isoformat(),
            "next_billing_date": config.next_billing_date.isoformat() if config.next_billing_date else None,
            "billing_enabled": bool(getattr(config, "billing_enabled", True)),
            "auto_create_invoices": bool(getattr(config, "auto_create_invoices", True)),
            "doc_type": None, "date_due": None, "lines": [],
            "subtotal": "0.00", "tax_total": "0.00", "total": "0.00",
        }
        if doc:
            out.update({
                "doc_type": doc["doc_type"],
                "date_due": doc["date_due"].isoformat(),
                "period_start": doc["lines"][0]["period_start"].isoformat() if doc["lines"] else None,
                "period_end": doc["lines"][0]["period_end"].isoformat() if doc["lines"] else None,
                "lines": [
                    {
                        # Office only (the preview is staff-only): what part
                        # of the plan line is "Rand amount up". Never on the
                        # invoice itself (George, 13 Oct 2026).
                        "office_note": _uplift_note(customer, line, run_date, charge_notes),
                        "description": line["description"],
                        "quantity": f"{Decimal(line['quantity']):f}",
                        "unit_price": f"{Decimal(line['unit_price']):.2f}",
                        "tax_rate_pct": f"{Decimal(line['tax_rate_pct']):f}",
                        "total": f"{Decimal(line['total']):.2f}",
                    }
                    for line in doc["lines"]
                ],
                "subtotal": f"{doc['subtotal']:.2f}",
                "tax_total": f"{doc['tax_total']:.2f}",
                "total": f"{doc['total']:.2f}",
            })
        return Response(out)


class CustomerInvoicePreviewPdfView(APIView):
    """GET /api/customer-billing-config/<customer_id>/invoice-preview/pdf/?date=

    The PDF exactly as the client will get it (George, 13 Oct 2026: "Preview
    Invoice should be in PDF and show exactly what the client will see").
    The billing run's own _generate_document builds the invoice inside a
    transaction that is then ROLLED BACK, and the real invoice template
    renders it -- so there is one definition of the document and nothing is
    kept: no invoice, no number used, no ledger debit, no email (those go
    out on commit, which never happens). The number reads PREVIEW."""

    permission_classes = [permissions.IsAuthenticated, IsStaffMember, HasFinanceAccess]

    def get(self, request, customer_id):
        import datetime

        from django.http import HttpResponse

        from customers.models import Customer
        from customers.views import scope_customers_to_user
        from notifications.email_settings import get_email_config
        from notifications.pdf import render_invoice_pdf

        from .recurring import _generate_document

        customer = get_object_or_404(scope_customers_to_user(Customer.objects.all(), request.user), pk=customer_id)
        raw = (request.query_params.get("date") or "").strip()
        config = CustomerBillingConfig.for_customer(customer)
        if raw:
            try:
                run_date = datetime.date.fromisoformat(raw)
            except ValueError:
                return Response({"detail": "date must be YYYY-MM-DD."}, status=400)
        else:
            run_date = config.next_billing_date or timezone.localdate()

        pdf = None
        with transaction.atomic():
            config = CustomerBillingConfig.objects.get(pk=config.pk)
            config.send_billing_notifications = False
            before = set(Invoice.objects.filter(customer=customer).values_list("pk", flat=True))
            doc_type = _generate_document(customer, config, run_date, None, True, issue_date=run_date)
            if doc_type:
                invoice = Invoice.objects.filter(customer=customer).exclude(pk__in=before).order_by("-pk").first()
                if invoice is not None:
                    invoice.number = "PREVIEW"
                    pdf = render_invoice_pdf(invoice, get_email_config()["company_name"])
            transaction.set_rollback(True)

        if pdf is None:
            return Response({"detail": f"Nothing would be billed on {run_date:%d/%m/%Y}."}, status=404)
        resp = HttpResponse(pdf, content_type="application/pdf")
        resp["Content-Disposition"] = f'inline; filename="invoice-preview-{customer.customer_id or customer.pk}-{run_date.isoformat()}.pdf"'
        return resp


