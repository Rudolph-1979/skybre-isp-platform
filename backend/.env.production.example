# Copy to backend/.env on the VPS (or pass via `docker compose --env-file`) and fill in real values.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

DB_NAME=ispplatform
DB_USER=ispplatform
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# docker-compose.yml's `db` service reads this same file, and the postgres
# image expects these exact names — keep all six DB_*/POSTGRES_* values
# in sync (same db name, same user, same password) if you edit them.
POSTGRES_DB=ispplatform
POSTGRES_USER=ispplatform
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Lock CORS down to your real frontend origin(s) — never leave ALLOW_ALL on in production.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Enable once TLS (https) is live in front of the app (see DEPLOYMENT.md).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
BEHIND_HTTPS_PROXY=True

# Set to true only for the very first deploy if you want demo data. Leave false afterwards.
SEED_DEMO_DATA=False
GUNICORN_WORKERS=3

# Outbound email for customer notifications (welcome, statements, invoices,
# payment reminders, suspension notices). Fill in your domain's mail
# hosting details (or Google Workspace / a transactional provider's SMTP).
# Leave EMAIL_HOST blank and emails just get logged to the container's
# console instead of actually sending — useful to test the feature
# before you have real SMTP credentials.
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=587
EMAIL_HOST_USER=billing@yourdomain.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_YOUR_MAILBOX_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Skybre <billing@yourdomain.com>
COMPANY_NAME=Skybre
SITE_URL=https://yourdomain.com
