# Copy to backend/.env on the VPS (or pass via `docker compose --env-file`) and fill in real values.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

DB_NAME=ispplatform
DB_USER=ispplatform
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# docker-compose.yml's `db` service reads this same file, and the postgres
# image expects these exact names — keep all six DB_*/POSTGRES_* values
# in sync (same db name, same user, same password) if you edit them.
POSTGRES_DB=ispplatform
POSTGRES_USER=ispplatform
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Lock CORS down to your real frontend origin(s) — never leave ALLOW_ALL on in production.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Enable once TLS (https) is live in front of the app (see DEPLOYMENT.md).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
BEHIND_HTTPS_PROXY=True

# Set to true only for the very first deploy if you want demo data. Leave false afterwards.
SEED_DEMO_DATA=False
GUNICORN_WORKERS=3
