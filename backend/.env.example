SECRET_KEY=dev-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=*
DB_NAME=ispplatform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOW_ALL_ORIGINS=True

# Only read by docker-compose's `db` service (the postgres image expects
# these exact names) — keep in sync with DB_NAME/DB_USER/DB_PASSWORD above.
POSTGRES_DB=ispplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Outbound email — leave EMAIL_HOST blank to just print emails to the
# console (dev default). Fill in real SMTP details to actually send.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Skybre <no-reply@skybre.co.za>
COMPANY_NAME=Skybre
SITE_URL=https://skybre.co.za
