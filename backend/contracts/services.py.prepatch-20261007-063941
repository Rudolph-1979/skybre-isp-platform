class ContractError(ValueError):
    pass


# --- placeholders ----------------------------------------------------------


def _money(value):
    return f"{Decimal(value or 0).quantize(Decimal('0.01')):,.2f}".replace(",", " ")


def _vat(amount, rate_pct):
    amount = Decimal(amount or 0)
    return (amount * (Decimal("1") + Decimal(rate_pct or 0) / Decimal("100"))).quantize(Decimal("0.01"))


def _client_address(customer):
    parts = [customer.address, getattr(customer, "complex_or_area", ""), customer.city, customer.zip_code]
    return ", ".join(p.strip() for p in parts if p and p.strip())


def _table(head, rows):
    head_html = format_html_join("", "<th>{}</th>", ((h,) for h in head))
    body_html = format_html_join(
        "", "<tr>{}</tr>",
        ((format_html_join("", "<td>{}</td>", ((c,) for c in row)),) for row in rows),
    )
    return format_html('<table class="items"><thead><tr>{}</tr></thead><tbody>{}</tbody></table>',
                       head_html, body_html)


def merge_context(customer, lead=None, reference=""):
    from billing.models import Service
    from notifications.pdf import _company_block

    company, _ = _company_block()
    services = [] if customer.pk is None else list(
        Service.objects.filter(customer=customer)
        .exclude(status__in=["terminated", "cancelled"])
        .select_related("tariff", "customer")
        .order_by("pk")
    )
    rows = [
        (s.tariff.name, s.site_address_display() or "—",
         f"R {_money(s.tariff.price)}", f"R {_money(_vat(s.tariff.price, s.tariff.tax_rate_pct))}")
        for s in services
    ]
    plan, monthly_excl, monthly_incl = "", "", ""
    once_off_table, once_off_incl = "", ""
    if lead is not None and lead.interested_tariff_id:
        from sales.workflow import quote_totals

        totals = quote_totals(lead)
        plan = lead.interested_tariff.name
        monthly_excl, monthly_incl = _money(totals["monthly"]["excl"]), _money(totals["monthly"]["incl"])
        if not rows:
            rows = [(plan, _client_address(customer) or "—", f"R {monthly_excl}", f"R {monthly_incl}")]
        if lead.quote_items:
            rate = lead.interested_tariff.tax_rate_pct
            once_off_table = _table(
                ["Once-off", "Excl. VAT", "Incl. VAT"],
                [(i["label"], f"R {_money(i['amount'])}", f"R {_money(_vat(i['amount'], rate))}")
                 for i in lead.quote_items],
            )
            once_off_incl = _money(totals["once_off"]["incl"])
    elif services:
        first = services[0].tariff
        plan = first.name
        monthly_excl, monthly_incl = _money(first.price), _money(_vat(first.price, first.tax_rate_pct))
    services_table = (
        _table(["Plan", "Installation address", "Monthly excl. VAT", "Monthly incl. VAT"], rows) if rows else ""
    )
    start = getattr(customer, "effective_signup_date", None)
    return {
        "client_name": customer.full_name,
        "client_company": customer.company_name,
        "client_code": customer.customer_id,
        "id_number": customer.id_number,
        "vat_number": customer.vat_number,
        "client_email": customer.email,
        "client_phone": customer.phone,
        "client_address": _client_address(customer),
        "services_table": services_table,
        "plan": plan,
        "monthly_excl": monthly_excl,
        "monthly_incl": monthly_incl,
        "once_off_table": once_off_table,
        "once_off_incl": once_off_incl,
        "start_date": start.strftime("%d/%m/%Y") if start else "",
        "contract_reference": reference,
        "today": timezone.localdate().strftime("%d/%m/%Y"),
        "company_name": company["name"],
        "company_address": ", ".join(p for p in (company["address"], company["city"], company["postal_line"]) if p),
        "company_vat_number": company["vat_number"],
        "company_phone": company["phone"],
        "company_email": company["email"],
    }


def fill(body_html, context):
    try:
        return Template(body_html).render(Context(context))
    except TemplateSyntaxError as exc:
        raise ContractError(f"The template has a mistake in it: {exc}")


