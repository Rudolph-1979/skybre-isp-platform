"""Calling Conecto's endpoints.

Every call here obeys one rule: IT MUST NOT BREAK THE THING THAT
TRIGGERED IT. Creating a ticket in Skybre, or saving a customer, cannot
be allowed to fail because a Cloud Run function in another project is
slow or down. So every call is wrapped, given a short timeout, and its
outcome recorded in a ConectoCall row instead of raised.

That is not fire-and-forget. Fire-and-forget loses the event; this keeps
it. `conecto_resync` replays the failures, which is the answer to
Conecto having no retry queue of its own -- their spec says a failed
webhook is simply logged and dropped, so the durability has to live on
our side or nowhere.

Conecto gives each function its own Cloud Run URL rather than one base
with paths, so the endpoints are configured individually and every one is
overridable by environment variable.

Five endpoints at first (tickets, alerts, towns, client codes); Job
Dispatch added two more -- scheduleJob and setStockChecklist -- in the
section at the bottom.
"""
import logging

import requests
from django.conf import settings
from django.utils import timezone

from .models import ConectoCall

logger = logging.getLogger(__name__)

# Seconds. Short on purpose: this runs inside a request/response cycle a
# staff member is waiting on. A push that takes longer than this is one
# the resync command should deal with, not one to keep somebody waiting
# for.
TIMEOUT = getattr(settings, "CONECTO_TIMEOUT_SECONDS", 6)

#: Only the first of these is kept from an error body -- enough to see
#: what went wrong without storing a Cloud Run HTML error page in full.
DETAIL_LIMIT = 2000


def _enabled():
    """Off unless a key is configured.

    Deliberately opt-in: a fresh install, a staging copy, or a developer's
    laptop must not start posting real customer data at a production
    Firebase project because it inherited the code.
    """
    return bool(getattr(settings, "CONECTO_API_KEY", ""))


#: The two Job Dispatch endpoints, whose URLs Conecto published outright.
#:
#: Defaulted rather than left blank like the original six, because the
#: settings block that holds those was written before Job Dispatch existed
#: and is already deployed -- and a second patch of config/settings.py, to
#: add two keys to a dict, is more risk than a documented default. The
#: master switch is unchanged: with CONECTO_API_KEY unset nothing is sent
#: to these or to anything else. Putting the keys into CONECTO_URLS still
#: overrides them.
DEFAULT_URLS = {
    "scheduleJob": "https://africa-south1-skybre-connecto.cloudfunctions.net/scheduleJob",
    "setStockChecklist": "https://africa-south1-skybre-connecto.cloudfunctions.net/setStockChecklist",
    "cancelJob": "https://africa-south1-skybre-connecto.cloudfunctions.net/cancelJob",
    "addTicketReply": "https://africa-south1-skybre-connecto.cloudfunctions.net/addTicketReply",
    "invoiceCreated": "https://africa-south1-skybre-connecto.cloudfunctions.net/invoiceCreated",
    "statementCreated": "https://africa-south1-skybre-connecto.cloudfunctions.net/statementCreated",
    # Quotes, kept apart from invoices in the app (Conecto, 7 Oct 2026). Their
    # naming, same host as the rest; confirm the URL with them.
    "quoteCreated": "https://africa-south1-skybre-connecto.cloudfunctions.net/quoteCreated",
    # Both given by Conecto, 7 Oct 2026.
    "poolJobEvent": "https://africa-south1-skybre-connecto.cloudfunctions.net/poolJobEvent",
    "salesEvent": "https://africa-south1-skybre-connecto.cloudfunctions.net/salesEvent",
    # Confirmed by Conecto 7 Oct 2026, payload as push_usage sends it;
    # they answer {"success": true, "message": "Usage saved" | "Usage
    # updated"}. Sent by the daily conecto_push_usage --apply cron.
    "usageUpdated": "https://africa-south1-skybre-connecto.cloudfunctions.net/usageUpdated",
    # Financial notifications to the client's app -- payment reminders,
    # suspension warnings, suspended, payment received, service restored
    # (George, 12 Oct 2026). OUR name for a function Conecto builds; switched
    # on with CONECTO_NOTIFICATIONS_ENABLED once they confirm it is live.
    "customerNotification": "https://africa-south1-skybre-connecto.cloudfunctions.net/customerNotification",
}


def notifications_enabled():
    """customerNotification has its own switch on top of CONECTO_API_KEY:
    until Conecto has deployed the function every push would fail and sit in
    ConectoCall waiting to be replayed as stale news. Read from the
    environment (backend/.env), so turning it on is a config change only."""
    from decouple import config

    return bool(config("CONECTO_NOTIFICATIONS_ENABLED", default=False, cast=bool))


def push_notification(payload):
    """Send one customer notification. Never raises (see call())."""
    if not notifications_enabled():
        return None
    return call(
        "customerNotification", payload,
        subject_kind="notification", subject_ref=payload.get("notification_id", ""),
    )


def _url(name):
    configured = getattr(settings, "CONECTO_URLS", {}).get(name, "")
    return configured or DEFAULT_URLS.get(name, "")


def _headers():
    return {
        "Authorization": f"Bearer {settings.CONECTO_API_KEY}",
        "Content-Type": "application/json",
    }


def call(endpoint, payload, *, url=None, method="post", subject_kind="", subject_ref="",
         existing=None):
    """Make one call, record it, and never raise.

    Returns the parsed response dict on success, or None. Callers that
    need the response (createTicket returns the id everything else keys
    off) must handle None -- and the ConectoCall row is what makes that
    recoverable rather than lost.

    `existing` is a ConectoCall being RETRIED: it is updated in place and
    its attempt count raised, rather than a second row appearing beside
    it. A replay is another attempt at one event, not a new event, and a
    table that grew a row per retry would stop being readable as "what
    still needs fixing" -- which is the only reason it exists.
    """
    target = url or _url(endpoint)
    if not _enabled() or not target:
        # Not an error worth a row: the integration is simply switched off.
        return None

    if existing is not None:
        record = existing
        record.attempts += 1
        record.status = ConectoCall.Status.FAILED
        record.http_status = None
        record.detail = ""
    else:
        record = ConectoCall(
            endpoint=endpoint,
            payload=payload,
            status=ConectoCall.Status.FAILED,
            subject_kind=subject_kind,
            subject_ref=str(subject_ref or ""),
        )

    try:
        response = requests.request(
            method, target, json=payload, headers=_headers(), timeout=TIMEOUT
        )
        record.http_status = response.status_code
        if response.ok:
            record.status = ConectoCall.Status.OK
            record.completed_at = timezone.now()
            record.save()
            try:
                return response.json()
            except ValueError:
                # 200 with a body we can't parse. The call landed, so it is
                # not a failure -- but the caller gets nothing, which for
                # createTicket means no id to store.
                logger.warning("Conecto %s returned unparseable JSON", endpoint)
                return None
        record.detail = (response.text or "")[:DETAIL_LIMIT]
    except requests.RequestException as exc:
        # Timeout, DNS, connection reset, TLS. No http_status to record.
        record.detail = f"{type(exc).__name__}: {exc}"[:DETAIL_LIMIT]

    record.save()
    logger.warning(
        "Conecto %s failed (%s) for %s %s: %s",
        endpoint, record.http_status, subject_kind, subject_ref, record.detail[:200],
    )
    return None


