from decimal import Decimal, ROUND_HALF_UP

from django.conf import settings
from django.db import models


class Vehicle(models.Model):
    """A company vehicle -- make/model/year plus an optional assigned
    driver. Odometer, service, and fuel history live in the models below,
    keyed off this one; "current km", "next service due", and fuel
    consumption are derived from that history rather than stored here, so
    they can never drift out of sync with it."""

    class FuelType(models.TextChoices):
        PETROL = "petrol", "Petrol"
        DIESEL = "diesel", "Diesel"

    make = models.CharField(max_length=100)
    model = models.CharField(max_length=100)
    year = models.PositiveIntegerField()
    registration_number = models.CharField(max_length=30, unique=True)
    fuel_type = models.CharField(max_length=10, choices=FuelType.choices, default=FuelType.PETROL)
    assigned_to = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="assigned_vehicles",
        limit_choices_to={"role__in": ["admin", "support", "sales", "technician", "management", "accounts"]},
    )
    # The annual licence disc. Nullable because it is not known for every
    # vehicle on the day this field arrives, and a made-up date is worse
    # than an empty one -- an empty one reads as "nobody has told us",
    # which is true and is somebody's job.
    licence_expiry = models.DateField(
        null=True, blank=True, verbose_name="Licence disc expires",
        help_text="The date on the current licence disc. Renewing sets this a year on.",
    )
    service_interval_km = models.PositiveIntegerField(
        default=10000, help_text="A service is due every this many kilometers."
    )
    # Its own interval, not derived from service_interval_km: Rudolph, 28
    # Sep, asked for tyre rotation reminders and specifically noted "tyres
    # arent always fitted with a service" -- a rotation can happen on its
    # own visit, on a different schedule from a full service, so the two
    # cannot share one number.
    tyre_rotation_interval_km = models.PositiveIntegerField(
        default=10000, help_text="Tyres should be rotated every this many kilometers."
    )
    is_active = models.BooleanField(default=True)
    # Set when the vehicle goes into the workshop, cleared when the service
    # is logged. A DATE rather than a boolean because "how long has this
    # been in for a service" is the question that follows immediately, and
    # a flag cannot answer it -- a bakkie that has been off the road for
    # eleven days is a different conversation from one booked in this
    # morning, and a boolean makes those look identical.
    in_service_since = models.DateField(
        null=True, blank=True,
        help_text="Date it went in for a service. Set = at the workshop now. Cleared automatically when a service is logged.",
    )
    notes = models.TextField(blank=True)
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["make", "model"]

    def __str__(self):
        return f"{self.year} {self.make} {self.model} ({self.registration_number})"

    @property
    def current_odometer_km(self):
        latest = self.odometer_readings.order_by("-reading_km", "-recorded_at").first()
        return latest.reading_km if latest else 0

    @property
    def last_service(self):
        return self.service_records.order_by("-service_date", "-id").first()

    @property
    def last_service_date(self):
        service = self.last_service
        return service.service_date if service else None

    @property
    def last_service_km(self):
        service = self.last_service
        return service.odometer_km if service else 0

    @property
    def next_service_due_km(self):
        return self.last_service_km + self.service_interval_km

    @property
    def km_until_due(self):
        return self.next_service_due_km - self.current_odometer_km

    @property
    def service_status(self):
        """"in_service" while it's at the workshop, otherwise "overdue"
        once past the due km, "due_soon" inside a warning band before it
        (10% of the interval, or 500km, whichever is bigger -- so short
        intervals still get a sensible heads-up window), else "ok".

        Being at the workshop OVERRIDES the km-derived states, and that
        ordering is the point of the state existing. A bakkie booked in
        this morning is still 2,000km past its due mark, so the derived
        answer is "overdue" -- which reads as nobody having dealt with it,
        when somebody is dealing with it right now. Whoever is scanning
        this list is deciding what to chase, and a vehicle already at the
        workshop is the one thing on it that needs no chasing.
        """
        if self.in_service_since:
            return "in_service"
        km_until = self.km_until_due
        if km_until <= 0:
            return "overdue"
        warning_band = max(int(self.service_interval_km * 0.1), 500)
        if km_until <= warning_band:
            return "due_soon"
        return "ok"

    @property
    def days_in_service(self):
        """How long it has been at the workshop, or None if it isn't."""
        if not self.in_service_since:
            return None
        from django.utils import timezone

        return max(0, (timezone.localdate() - self.in_service_since).days)

    @property
    def last_tyre_rotation(self):
        return self.tyre_rotations.order_by("-rotation_date", "-id").first()

    @property
    def last_tyre_rotation_date(self):
        rotation = self.last_tyre_rotation
        return rotation.rotation_date if rotation else None

    @property
    def last_tyre_rotation_km(self):
        rotation = self.last_tyre_rotation
        return rotation.odometer_km if rotation else 0

    @property
    def next_tyre_rotation_due_km(self):
        return self.last_tyre_rotation_km + self.tyre_rotation_interval_km

    @property
    def km_until_tyre_rotation_due(self):
        return self.next_tyre_rotation_due_km - self.current_odometer_km

    @property
    def tyre_rotation_status(self):
        """"overdue" once past the due km, "due_soon" inside the same
        10%-of-interval-or-500km warning band service_status uses, else
        "ok" -- same arithmetic as service_status, on purpose, so the two
        badges read the same way at a glance.

        Deliberately NOT overridden by in_service_since the way
        service_status is. That override exists because a vehicle already
        at the workshop for a SERVICE needs no chasing for one -- but
        being booked in for a service doesn't mean this visit includes a
        tyre rotation, so a rotation genuinely overdue stays "overdue"
        even while the vehicle sits in service for something else.
        """
        km_until = self.km_until_tyre_rotation_due
        if km_until <= 0:
            return "overdue"
        warning_band = max(int(self.tyre_rotation_interval_km * 0.1), 500)
        if km_until <= warning_band:
            return "due_soon"
        return "ok"

    # How far ahead a disc renewal counts as "coming up". 30 days is what
    # this one realistically needs: it is a form and a payment, so the
    # window only has to be long enough to get the money approved and get
    # to a counter. Wider than that and the list fills with things nobody
    # can act on yet, which is how a list stops being read.
    #
    # A driver's licence uses a different window, for a real reason -- see
    # payroll.StaffProfile.RENEWAL_NOTICE_DAYS and fleet/renewals.py.
    RENEWAL_NOTICE_DAYS = 30

    # A disc runs one year. The default when somebody presses Renew
    # without typing a date.
    LICENCE_TERM_YEARS = 1

    @property
    def licence_days_left(self):
        """Days until the disc expires. Negative once it has. None when
        nobody has captured a date."""
        from .renewals import days_until

        return days_until(self.licence_expiry)

    @property
    def licence_status(self):
        """"expired", "due_soon", "ok", or "unknown" -- decided in
        fleet/renewals.py, so that a disc and a driver's licence can never
        drift apart on what those words mean."""
        from .renewals import renewal_status

        return renewal_status(self.licence_expiry, self.RENEWAL_NOTICE_DAYS)

    @property
    def total_litres_used(self):
        total = self.fuel_logs.aggregate(total=models.Sum("litres"))["total"]
        return total or Decimal("0")

    @property
    def average_km_per_litre(self):
        """Full-to-full method: total distance covered between the
        earliest and latest fill-up, divided by all litres put in since
        (excluding the earliest log's litres, since those fuelled the
        vehicle before the tracked distance began). Needs at least two
        fuel logs to mean anything."""
        logs = list(self.fuel_logs.order_by("odometer_km", "filled_at"))
        if len(logs) < 2:
            return None
        distance = logs[-1].odometer_km - logs[0].odometer_km
        litres = sum((log.litres for log in logs[1:]), Decimal("0"))
        if distance <= 0 or litres <= 0:
            return None
        return round(distance / float(litres), 2)

    def fuel_summary(self, today=None):
        """What this vehicle has cost in fuel: this month, this year, ever.

        Every figure here counts ONLY fill-ups that carry a cost, and every
        figure is reported beside the number that do not. Fill-ups logged
        before the cost field existed have none, and a monthly total that
        quietly treated those as R0.00 would read low with nothing on the
        page to say why -- which is the specific way a spend figure stops
        being trusted and then stops being looked at.

        `rand_per_km` is deliberately null while ANY fill-up is missing a
        cost. Cost per kilometre divides money by distance, and distance
        comes from every fill-up while the money comes from only some of
        them: the answer would be too low by exactly the proportion that
        is missing, and it would look perfectly reasonable. A blank with a
        reason beats a plausible wrong number.
        """
        from django.utils import timezone

        today = today or timezone.localdate()
        logs = list(self.fuel_logs.all())
        costed = [log for log in logs if log.cost is not None]

        def total(rows):
            # Quantized here so the API emits "0.00" rather than "0", and so
            # every money figure on the page has the same shape.
            return sum((Decimal(row.cost) for row in rows), Decimal("0")).quantize(
                Decimal("0.01"), rounding=ROUND_HALF_UP
            )

        this_month = [log for log in costed
                      if log.filled_at.year == today.year and log.filled_at.month == today.month]
        this_year = [log for log in costed if log.filled_at.year == today.year]

        missing = len(logs) - len(costed)
        litres_costed = sum((Decimal(log.litres) for log in costed), Decimal("0"))

        rand_per_km = None
        if costed and not missing and len(logs) >= 2:
            ordered = sorted(logs, key=lambda log: (log.odometer_km, log.filled_at))
            distance = ordered[-1].odometer_km - ordered[0].odometer_km
            # Same full-to-full reasoning as average_km_per_litre: the first
            # fill-up fuelled the distance BEFORE this record starts, so its
            # cost does not belong to the distance being measured.
            spend_after_first = total(ordered[1:])
            if distance > 0 and spend_after_first > 0:
                rand_per_km = (spend_after_first / Decimal(distance)).quantize(
                    Decimal("0.01"), rounding=ROUND_HALF_UP
                )

        return {
            "month": total(this_month),
            "year": total(this_year),
            "lifetime": total(costed),
            "average_rand_per_litre": (
                (total(costed) / litres_costed).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
                if litres_costed else None
            ),
            "rand_per_km": rand_per_km,
            # Counted, not hidden: this is what the page says out loud.
            "missing_cost_count": missing,
            "month_missing_cost_count": sum(
                1 for log in logs
                if log.cost is None
                and log.filled_at.year == today.year
                and log.filled_at.month == today.month
            ),
        }

    def maintenance_summary(self, today=None):
        """What this vehicle has cost beyond fuel, and the running cost per
        km (13 Oct 2026).

        "Maintenance" is every expense linked to this vehicle under
        Accountant -> Expenses -- services, repairs, tyres, parts. Counted
        EXCLUDING VAT, because the VAT on them is claimed back as input tax:
        what the business actually carries is the net figure. Fuel needs no
        such treatment; it carries no VAT.

        The per-km figure uses the SAME distance as the fuel figure: the
        first to the last fill-up by odometer (see fuel_summary). Only
        maintenance dated inside that window is spread over it -- an
        invoice from before the fuel record starts belongs to kilometres
        nobody measured. Those are still in the totals, and counted in
        `outside_window_count` so the page can say why they don't move the
        per-km figure.

        `running_rand_per_km` is fuel per km plus maintenance per km, and is
        null whenever the fuel figure is (a fill-up without a cost would
        make it read low, for the reason fuel_summary gives).
        """
        from django.utils import timezone

        today = today or timezone.localdate()
        rows = list(self.expenses.all())

        def total(items):
            return sum((Decimal(e.amount_excl_vat) for e in items), Decimal("0")).quantize(
                Decimal("0.01"), rounding=ROUND_HALF_UP
            )

        this_month = [e for e in rows if e.date.year == today.year and e.date.month == today.month]
        this_year = [e for e in rows if e.date.year == today.year]

        rand_per_km = None
        outside = len(rows)
        logs = sorted(self.fuel_logs.all(), key=lambda log: (log.odometer_km, log.filled_at))
        if len(logs) >= 2:
            first, last = logs[0], logs[-1]
            distance = last.odometer_km - first.odometer_km
            inside = [e for e in rows if first.filled_at <= e.date <= last.filled_at]
            outside = len(rows) - len(inside)
            if distance > 0:
                rand_per_km = (total(inside) / Decimal(distance)).quantize(
                    Decimal("0.01"), rounding=ROUND_HALF_UP
                )

        fuel_per_km = self.fuel_summary(today)["rand_per_km"]
        running = None
        if fuel_per_km is not None and rand_per_km is not None:
            running = fuel_per_km + rand_per_km

        return {
            "month": total(this_month),
            "year": total(this_year),
            "lifetime": total(rows),
            "count": len(rows),
            "rand_per_km": rand_per_km,
            "running_rand_per_km": running,
            "outside_window_count": outside,
        }


class OdometerReading(models.Model):
    """One logged odometer reading for a vehicle. The vehicle's "current
    km" is always its highest reading. An odometer only counts up, so a
    reading may not sit below one taken before it or above one taken after
    it (enforced in the serializer, not here, to give a clean API error
    rather than a 500) -- the rule is about the order of the readings IN
    TIME, not the order they were typed in, because logbooks arrive late
    and a reading keyed in wrong has to stay correctable."""

    vehicle = models.ForeignKey(Vehicle, on_delete=models.CASCADE, related_name="odometer_readings")
    reading_km = models.PositiveIntegerField()
    recorded_at = models.DateTimeField()
    recorded_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, related_name="+"
    )
    notes = models.CharField(max_length=255, blank=True)
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["-recorded_at", "-id"]

    def __str__(self):
        return f"{self.vehicle} — {self.reading_km} km"


class ServiceRecord(models.Model):
    """A logged service event -- resets "next service due" from this
    point (last_service_km + service_interval_km on the Vehicle)."""

    vehicle = models.ForeignKey(Vehicle, on_delete=models.CASCADE, related_name="service_records")
    service_date = models.DateField()
    odometer_km = models.PositiveIntegerField()
    notes = models.TextField(blank=True)
    logged_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, related_name="+"
    )
    created_at = models.DateTimeField(auto_now_add=True)

    # The workshop invoice for this service, captured under Accountant ->
    # Expenses with this vehicle picked (13 Oct 2026). Optional, one invoice
    # per service. SET_NULL: deleting the expense must not delete the record
    # that the vehicle was serviced.
    expense = models.OneToOneField(
        "expenses.Expense",
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="service_record",
    )

    class Meta:
        ordering = ["-service_date", "-id"]

    def __str__(self):
        return f"{self.vehicle} serviced {self.service_date}"


class TyreRotation(models.Model):
    """A logged tyre-rotation event -- resets "next rotation due" from
    this point (last_tyre_rotation_km + tyre_rotation_interval_km on the
    Vehicle). Deliberately its own model rather than a flag on
    ServiceRecord: a rotation does not always happen at a service, and a
    service does not always include one, so tying the two together would
    either force a rotation to wait for the next service or lose the
    record of one done on its own."""

    vehicle = models.ForeignKey(Vehicle, on_delete=models.CASCADE, related_name="tyre_rotations")
    rotation_date = models.DateField()
    odometer_km = models.PositiveIntegerField()
    notes = models.TextField(blank=True)
    logged_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, related_name="+"
    )
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["-rotation_date", "-id"]

    def __str__(self):
        return f"{self.vehicle} tyres rotated {self.rotation_date}"


class FuelLog(models.Model):
    """One fuel fill-up for a vehicle -- litres added plus the odometer
    reading at the time, so average consumption can be derived using the
    standard full-to-full method (see Vehicle.average_km_per_litre)."""

    vehicle = models.ForeignKey(Vehicle, on_delete=models.CASCADE, related_name="fuel_logs")
    filled_at = models.DateField()
    litres = models.DecimalField(max_digits=7, decimal_places=2)
    # What was actually paid, VAT included -- the figure on the slip, not
    # litres x pump price. Those two differ by a few cents once rounding is
    # involved, and the one that has to be exact is what the monthly spend
    # is built from. Rand per litre is derived FROM this rather than
    # entered beside it: one number to type at a fuel station, and no way
    # for two entered figures to contradict each other.
    #
    # Nullable because every fill-up logged before this field existed has
    # no cost, and inventing one would be worse than leaving the gap
    # visible. Nothing that totals money treats a null as zero -- the
    # summaries below report how many are missing instead.
    cost = models.DecimalField(
        max_digits=10, decimal_places=2, null=True, blank=True,
        verbose_name="Total paid (R)",
        help_text="The total on the slip, VAT included. Leave blank if it isn't known.",
    )
    odometer_km = models.PositiveIntegerField()
    notes = models.CharField(max_length=255, blank=True)
    logged_by = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, related_name="+"
    )
    # Fuel slips captured by technicians in the Conecto app (7 Oct 2026).
    # conecto_fuel_id is Conecto's own id -- their retry key, so a repeat
    # never makes a second fill-up. Everything else they send that has no
    # column here (what their AI read off the slip, the litre price, the
    # fuel type...) is kept in conecto_data.
    class Source(models.TextChoices):
        STAFF = "staff", "Logged here"
        CONECTO = "conecto", "Conecto app"

    source = models.CharField(max_length=10, choices=Source.choices, default=Source.STAFF)
    conecto_fuel_id = models.CharField(max_length=64, null=True, blank=True, unique=True)
    station = models.CharField(max_length=120, blank=True)
    slip_url = models.URLField(max_length=1000, blank=True)
    # Conecto's check: litres x price is more than 3% off the slip's total.
    amount_mismatch = models.BooleanField(default=False)
    conecto_data = models.JSONField(default=dict, blank=True)
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["-filled_at", "-id"]

    def __str__(self):
        return f"{self.vehicle} — {self.litres} L on {self.filled_at}"

    @property
    def price_per_litre(self):
        """Derived, never stored. A stored copy would be a second version of
        a number that can be computed, and the two would disagree the first
        time somebody corrected a cost."""
        if self.cost is None or not self.litres:
            return None
        return (Decimal(self.cost) / Decimal(self.litres)).quantize(
            Decimal("0.01"), rounding=ROUND_HALF_UP
        )


class TripLog(models.Model):
    """One trip a technician logged in the Conecto app: start and end
    odometer, with photos (7 Oct 2026). The end reading also lands in the
    vehicle's odometer history when it fits there (see fleet.conecto_logs).
    conecto_trip_id is Conecto's retry key."""

    vehicle = models.ForeignKey(Vehicle, on_delete=models.CASCADE, related_name="trip_logs")
    driver = models.ForeignKey(
        settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True, blank=True, related_name="+"
    )
    driver_name = models.CharField(max_length=150, blank=True)
    conecto_trip_id = models.CharField(max_length=64, null=True, blank=True, unique=True)
    start_odometer = models.PositiveIntegerField()
    end_odometer = models.PositiveIntegerField()
    km_driven = models.PositiveIntegerField()
    started_at = models.DateTimeField()
    ended_at = models.DateTimeField()
    start_photo_url = models.URLField(max_length=1000, blank=True)
    end_photo_url = models.URLField(max_length=1000, blank=True)
    notes = models.TextField(blank=True)
    # False when the end reading could not go into the odometer history
    # because it contradicts readings already there -- worth a look.
    odometer_recorded = models.BooleanField(default=False)
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["-started_at", "-id"]

    def __str__(self):
        return f"{self.vehicle} — {self.km_driven} km on {self.started_at:%Y-%m-%d}"
