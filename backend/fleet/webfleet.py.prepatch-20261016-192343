# ---- trips -------------------------------------------------------------------

def trip_row(raw):
    start_m = _num(raw.get("start_odometer"), int)
    end_m = _num(raw.get("end_odometer"), int)
    distance_m = _num(raw.get("distance"))
    return {
        "trip_id": _num(raw.get("tripid"), int),
        "objectno": str(raw.get("objectno") or ""),
        "started_at": _when(raw.get("start_time")),
        "ended_at": _when(raw.get("end_time")),
        "start_place": raw.get("start_postext") or "",
        "end_place": raw.get("end_postext") or "",
        "start_km": None if start_m is None else int(start_m // 1000),
        "end_km": None if end_m is None else int(end_m // 1000),
        "distance_km": int(round((distance_m or 0) / 1000)),
        "driver_name": (raw.get("drivername") or "")[:150],
    }


def sync_trips(state):
    """Webfleet's trips into the vehicle's existing Trips list (TripLog),
    keyed on Webfleet's tripid. Continuous replication: everything after
    the highest tripid seen; the very first run takes the floating week.
    Each trip's END odometer goes into the odometer history (#189, Rudolph
    16 Oct: "I need more km readings" -> one at the end of every trip),
    logged by Webfleet, notes left empty, only where it fits the history."""
    from .conecto_logs import add_reading
    from .models import TripLog

    if state.last_trip_id:
        raw = call("showTripReportExtern", tripid=state.last_trip_id)
    else:
        raw = call("showTripReportExtern", range_pattern="wf0")
    linked = linked_vehicles()
    new = 0
    state.odometer_added = 0
    highest = state.last_trip_id or 0
    for r in sorted(map(trip_row, raw), key=lambda t: (t["ended_at"] is None, t["ended_at"] or 0)):
        if r["trip_id"] is None:
            continue
        highest = max(highest, r["trip_id"])
        v = linked.get(r["objectno"])
        if v is None or not r["started_at"] or not r["ended_at"]:
            continue
        end_km = r["end_km"] if r["end_km"] is not None else 0
        start_km = r["start_km"] if r["start_km"] is not None else max(0, end_km - r["distance_km"])
        route = " → ".join(p for p in (r["start_place"], r["end_place"]) if p)
        _obj, created = TripLog.objects.update_or_create(webfleet_trip_id=r["trip_id"], defaults={
            "vehicle": v, "driver_name": r["driver_name"], "start_odometer": start_km, "end_odometer": max(end_km, start_km),
            "km_driven": r["distance_km"], "started_at": r["started_at"], "ended_at": r["ended_at"],
            "notes": f"Webfleet: {route}" if route else "Webfleet",
        })
        new += int(created)
        if r["end_km"]:
            before = v.odometer_readings.count()
            fits = add_reading(v, r["end_km"], r["ended_at"], None, "", source="webfleet")
            state.odometer_added += v.odometer_readings.count() - before
        else:
            fits = True  # no odometer from Webfleet: nothing to contradict
        if _obj.odometer_recorded != fits:
            _obj.odometer_recorded = fits
            _obj.save(update_fields=["odometer_recorded"])
    state.last_trip_id = highest or None
    return new


def backfill_trip_odometers():
    """Odometer readings for Webfleet trips already in the Trips list --
    the ones synced before #189 (once, from the deploy)."""
    from .conecto_logs import add_reading
    from .models import TripLog

    added = 0
    for t in TripLog.objects.exclude(webfleet_trip_id=None).filter(end_odometer__gt=0).select_related("vehicle").order_by("ended_at"):
        before = t.vehicle.odometer_readings.count()
        fits = add_reading(t.vehicle, t.end_odometer, t.ended_at, None, "", source="webfleet")
        added += t.vehicle.odometer_readings.count() - before
        if t.odometer_recorded != fits:
            t.odometer_recorded = fits
            t.save(update_fields=["odometer_recorded"])
    return added


# ---- OptiDrive (KPIs) ----------------------------------------------------------

def sync_optidrive(sleep=time.sleep):
    """OptiDrive per vehicle per day for the last 8 days (Webfleet's
    floating week), one call per linked vehicle, spaced to stay inside 10
    calls a minute."""
    from .models import Vehicle, WebfleetDay

    updated = 0
    vehicles = list(Vehicle.objects.exclude(webfleet_objectno="").filter(is_active=True))
    for i, v in enumerate(vehicles):
        if i:
            sleep(KPI_GAP_S)
        for raw in call("getObjectKPIs", objectno=v.webfleet_objectno, kpinames="optidrive", level="day", range_pattern="wf0"):
            try:
                day = datetime(int(raw["year"]), int(raw["month"]), int(raw["day"])).date()
            except (KeyError, TypeError, ValueError):
                continue
            score = _num(raw.get("optidrive_indicator"))
            if score is None:
                continue
            WebfleetDay.objects.update_or_create(vehicle=v, date=day, defaults={"optidrive": score})
            updated += 1
    return updated


# ---- speeding (#188) ----------------------------------------------------------

def speeding_row(raw):
    limits = [_num(raw.get(k)) for k in ("road_speedlimit", "area_speedlimit", "object_speedlimit")]
    limits = [l for l in limits if l and l > 0]
    duration_ms = _num(raw.get("duration"), int)
    return {
        "started_at": _when(raw.get("start_time")),
        "ended_at": _when(raw.get("end_time")),
        "max_speed_kmh": _num(raw.get("max_speed"), int),
        "avg_speed_kmh": _num(raw.get("avg_speed"), int),
        "limit_kmh": int(min(limits)) if limits else None,
        "place": (raw.get("start_postext") or raw.get("end_postext") or "")[:255],
        "driver_name": (raw.get("drivername") or "")[:100],
        "duration_s": int((duration_ms or 0) // 1000),
        "distance_m": _num(raw.get("distance"), int) or 0,
    }


def sync_speeding(sleep=time.sleep):
    """Today's speeding events for every linked vehicle, one call each
    (showSpeedingEvents: 10 a minute)."""
    from .models import Vehicle, WebfleetSpeeding

    new = 0
    vehicles = list(Vehicle.objects.exclude(webfleet_objectno="").filter(is_active=True))
    for i, v in enumerate(vehicles):
        if i:
            sleep(KPI_GAP_S)
        for raw in call("showSpeedingEvents", objectno=v.webfleet_objectno, range_pattern="d0"):
            row = speeding_row(raw)
            if not row["started_at"]:
                continue
            start = row.pop("started_at")
            _obj, created = WebfleetSpeeding.objects.update_or_create(vehicle=v, started_at=start, defaults=row)
            new += int(created)
    return new


# ---- the whole run (management command sync_webfleet, cron every 15 min) -------

def sync(force_kpis=False, sleep=time.sleep):
    from .models import WebfleetSync

    state = WebfleetSync.load()
    notes, ok = [], True
    steps = [
        ("link", lambda: f"{auto_link()} vehicle(s) linked"),
        ("positions", None),
        ("trips", lambda: f"{sync_trips(state)} new trip(s), {getattr(state, 'odometer_added', 0)} odometer reading(s)"),
    ]
    for name, step in steps:
        try:
            if name == "positions":
                rows = objects(use_cache=False)
                # km readings now come from each trip's end (#189), not once a day.
                notes.append(f"{len(rows)} object(s)")
            else:
                notes.append(step())
        except WebfleetError as exc:
            ok = False
            notes.append(str(exc))
            if not isinstance(exc, WebfleetQuota) and exc.code in ("1106", "1143", "8014"):
                break  # credentials: the rest would fail the same way
    if ok:
        try:
            notes.append(f"{sync_speeding(sleep=sleep)} new speeding event(s)")
        except WebfleetError as exc:
            ok = False
            notes.append(str(exc))
    now = timezone.now()
    if ok and (force_kpis or not state.last_kpis_at or now - state.last_kpis_at >= KPI_EVERY):
        try:
            notes.append(f"{sync_optidrive(sleep=sleep)} OptiDrive day(s)")
            state.last_kpis_at = now
        except WebfleetError as exc:
            ok = False
            notes.append(str(exc))
    state.last_run_at = now
    state.last_ok = ok
    state.last_message = "; ".join(notes)[:2000]
    state.save()
    return ok, state.last_message
