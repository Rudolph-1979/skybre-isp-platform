"""Webfleet (Bridgestone) vehicle tracking, read-only (#186).

Rudolph, 16 Oct 2026: "Next look at Webfleet Tracking company" -> vehicles
on the map, automatic odometer, trips, OptiDrive. Then: "I dont want extras
in the vehicle page, webfleet must just add to our current build except we
can add optidrive" -- so Webfleet trips go into the existing Trips list,
odometer readings into the existing odometer history, and the only new
figure on the vehicle page is OptiDrive.

WEBFLEET.connect (docs 1.76.0, read 16 Oct 2026):
* HTTPS GET https://csv.webfleet.com/extern?account=..&apikey=..&lang=en
  &action=..&outputformat=json&useISO8601=true&useUTF8=true, with the
  Webfleet user as HTTP Basic auth (user/password in the URL is deprecated,
  removed end of June 2026).
* Errors: X-Webfleet-Errorcode / X-Webfleet-Errormessage headers (or an
  errorCode object). 63 = no data, 8011 = request quota reached.
* Limits used here: showObjectReportExtern 6/min (cached 30 s),
  showVehicleReportExtern 10/min, showTripReportExtern 1/min (continuous
  replication by tripid, not more often than every 15 min),
  getObjectKPIs 10/min (OptiDrive only, one call per vehicle, spaced out).

Nothing is ever written to Webfleet.
"""
import logging
import re
import time
from datetime import datetime, timedelta
from decimal import Decimal, InvalidOperation

import requests
from django.conf import settings
from django.core.cache import cache
from django.utils import timezone
from django.utils.dateparse import parse_datetime

logger = logging.getLogger(__name__)

URL = "https://csv.webfleet.com/extern"
POSITIONS_CACHE = "webfleet:objects"
POSITIONS_TTL = 30
KPI_GAP_S = 6.5          # getObjectKPIs: 10/min
KPI_EVERY = timedelta(hours=1)


class WebfleetError(Exception):
    def __init__(self, message, code=None):
        super().__init__(message)
        self.code = code


class WebfleetQuota(WebfleetError):
    """8011: wait for the next run."""


def configured():
    return all(getattr(settings, k, "") for k in ("WEBFLEET_ACCOUNT", "WEBFLEET_USERNAME", "WEBFLEET_PASSWORD", "WEBFLEET_API_KEY"))


def call(action, **params):
    """One WEBFLEET.connect action -> list of dicts ([] for 'no data')."""
    if not configured():
        raise WebfleetError("Webfleet isn't set up (WEBFLEET_* in backend/.env).")
    query = {
        "account": settings.WEBFLEET_ACCOUNT, "apikey": settings.WEBFLEET_API_KEY, "lang": "en",
        "action": action, "outputformat": "json", "useISO8601": "true", "useUTF8": "true",
        **{k: v for k, v in params.items() if v not in (None, "")},
    }
    try:
        resp = requests.get(URL, params=query, auth=(settings.WEBFLEET_USERNAME, settings.WEBFLEET_PASSWORD), timeout=25)
    except requests.RequestException as exc:
        raise WebfleetError(f"Couldn't reach Webfleet: {exc}") from exc
    code = resp.headers.get("X-Webfleet-Errorcode")
    message = resp.headers.get("X-Webfleet-Errormessage", "")
    payload = None
    if not code:
        try:
            payload = resp.json()
        except ValueError:
            text = (resp.text or "").strip()
            m = re.match(r"^(\d+)\s*,\s*(.*)$", text)
            if m:
                code, message = m.group(1), m.group(2)
            elif resp.status_code >= 400:
                code, message = str(resp.status_code), text[:300]
            else:
                raise WebfleetError(f"Webfleet answered {action} with something that isn't JSON: {text[:200]}")
        if isinstance(payload, dict) and payload.get("errorCode") not in (None, 0, "0"):
            code, message = str(payload.get("errorCode")), payload.get("errorMsg") or payload.get("errorMessage") or ""
    if code and str(code) != "0":
        code = str(code)
        if code == "63":
            return []
        if code == "8011":
            raise WebfleetQuota(f"Webfleet request limit reached for {action} -- tries again next run.", code)
        hint = {
            "1106": " Check WEBFLEET_ACCOUNT / USERNAME / PASSWORD.",
            "1143": " Check WEBFLEET_API_KEY.",
            "8014": " The Webfleet user needs the WEBFLEET.connect interface right, and an API key must be used.",
            "45": " The Webfleet user lacks the access right for this report.",
        }.get(code, "")
        raise WebfleetError(f"Webfleet error {code} on {action}: {message}.{hint}", code)
    if isinstance(payload, dict):
        return [payload]
    return payload or []


# ---- small converters -------------------------------------------------------

def _num(v, kind=float):
    if v in (None, ""):
        return None
    try:
        return kind(v) if kind is not Decimal else Decimal(str(v))
    except (TypeError, ValueError, InvalidOperation):
        return None


def _when(v):
    if not v:
        return None
    dt = parse_datetime(str(v).replace(" ", "T")) if isinstance(v, str) else None
    if dt is None:
        return None
    if timezone.is_naive(dt):
        dt = timezone.make_aware(dt)
    return dt


def _mdeg(v):
    n = _num(v)
    return None if n is None else n / 1_000_000


def reg_key(text):
    return "".join(ch for ch in str(text or "").upper() if ch.isalnum())


# ---- live positions ----------------------------------------------------------

def object_row(raw):
    odo_m = _num(raw.get("odometer_long"), int)
    if odo_m is None:
        odo_100 = _num(raw.get("odometer"), int)
        odo_m = odo_100 * 100 if odo_100 is not None else None
    ign = raw.get("ignition")
    still = raw.get("standstill")
    return {
        "objectno": str(raw.get("objectno") or ""),
        "objectuid": raw.get("objectuid") or "",
        "name": raw.get("objectname") or "",
        "lat": _mdeg(raw.get("latitude_mdeg")),
        "lng": _mdeg(raw.get("longitude_mdeg")),
        "pos_time": _when(raw.get("pos_time")),
        "place": raw.get("postext") or "",
        "speed_kmh": _num(raw.get("speed"), int),
        "course": _num(raw.get("course"), int),
        "ignition": None if ign in (None, "") else str(ign) == "1",
        "standstill": None if still in (None, "") else str(still) == "1",
        "driver_name": raw.get("drivername") or "",
        "odometer_km": None if odo_m is None else int(odo_m // 1000),
        "fuel_level_pct": _num(raw.get("fuellevel"), int),
        "deleted": str(raw.get("deleted")).lower() == "true",
    }


def objects(use_cache=True):
    """All Webfleet objects with their last position (cached 30 s: the
    action allows 6 a minute for the whole account)."""
    if use_cache:
        hit = cache.get(POSITIONS_CACHE)
        if hit is not None:
            return hit
    rows = [object_row(r) for r in call("showObjectReportExtern")]
    rows = [r for r in rows if r["objectno"] and not r["deleted"]]
    cache.set(POSITIONS_CACHE, rows, POSITIONS_TTL)
    return rows


def linked_vehicles():
    """{Webfleet objectno: Vehicle} for every linked vehicle."""
    from .models import Vehicle

    return {v.webfleet_objectno: v for v in Vehicle.objects.exclude(webfleet_objectno="")}


# ---- linking -----------------------------------------------------------------

def auto_link():
    """Link unlinked Vexar vehicles to Webfleet objects with the same
    registration (Webfleet's licence plate, else a registration inside the
    object name). Returns the number linked."""
    from .models import Vehicle

    taken = set(Vehicle.objects.exclude(webfleet_objectno="").values_list("webfleet_objectno", flat=True))
    by_reg = {}
    for r in call("showVehicleReportExtern"):
        objectno = str(r.get("objectno") or "")
        if not objectno or objectno in taken:
            continue
        for text in (r.get("licenseplatenumber"), r.get("objectname")):
            key = reg_key(text)
            if len(key) >= 5:
                by_reg.setdefault(key, objectno)
    linked = 0
    for v in Vehicle.objects.filter(webfleet_objectno=""):
        key = reg_key(v.registration_number)
        objectno = by_reg.get(key) or next((o for k, o in by_reg.items() if key and key in k), None)
        if objectno and objectno not in taken:
            v.webfleet_objectno = objectno
            v.save(update_fields=["webfleet_objectno"])
            taken.add(objectno)
            linked += 1
    return linked


