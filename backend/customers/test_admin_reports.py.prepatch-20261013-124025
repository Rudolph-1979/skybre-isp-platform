class TariffCostTests(ReportFixture):
    """Cost per tariff and markup (George, 13 Oct 2026): cost on active AND
    suspended lines; uncosted tariffs left out and counted, never free."""

    def setUp(self):
        super().setUp()
        self.t4.cost_price = Decimal("60.00")
        self.t4.save()

    def test_tariff_row_cost_counts_suspended_lines(self):
        rows = self._by_name(self._get("/api/reports/clients-per-tariff/?status=active,online").data)
        w4 = rows["Wireless 4 Mbps"]        # Anna active (R149) + Ben suspended (R0), R60 cost each
        self.assertEqual(w4["monthly_cost"], "120.00")
        self.assertEqual(w4["gross_profit"], "29.00")
        self.assertEqual(w4["markup_pct"], "24.2")
        self.assertEqual(w4["margin_pct"], "19.5")
        self.assertEqual(w4["uncosted_lines"], 0)
        self.assertEqual((w4["unit_price"], w4["unit_cost"], w4["unit_markup_pct"]), ("149.00", "60.00", "148.3"))

    def test_uncosted_tariff_is_not_free(self):
        rows = self._by_name(self._get("/api/reports/clients-per-tariff/?status=active,online").data)
        f10 = rows["Fibre 10 Mbps"]
        self.assertIsNone(f10["monthly_cost"])
        self.assertIsNone(f10["markup_pct"])
        self.assertEqual(f10["uncosted_lines"], 1)
        self.assertIsNone(f10["unit_cost"])

    def test_total_is_over_costed_lines_only(self):
        total = self._get("/api/reports/clients-per-tariff/?status=active,online").data["total"]
        self.assertEqual(total["monthly_cost"], "120.00")
        self.assertEqual(total["gross_profit"], "29.00")
        self.assertEqual(total["uncosted_lines"], 1)
        self.assertEqual(total["monthly_excl"], "549.00")   # revenue total unchanged

    def test_partner_report_carries_cost_too(self):
        rows = self._by_name(self._get("/api/reports/clients-per-partner/?status=active,online").data)
        self.assertEqual(rows["Acme"]["monthly_cost"], "60.00")      # Ben's suspended line
        self.assertEqual(rows["Acme"]["gross_profit"], "-60.00")
        self.assertNotIn("unit_cost", rows["Acme"])

    def test_service_api_carries_cost_incl_vat(self):
        line = Service.objects.get(customer=self.anna, tariff=self.t10)
        self.api.force_authenticate(self.staff)
        res = self.api.get(f"/api/services/{line.pk}/")
        self.assertEqual(res.status_code, 200, res.data)
        if self.t10.cost_price is None:
            self.assertIsNone(res.data["cost_incl_vat"])
        self.t10.cost_price = Decimal("250.00")
        self.t10.save()
        res = self.api.get(f"/api/services/{line.pk}/")
        self.assertEqual(res.data["cost_incl_vat"], "287.50")
        self.assertEqual(res.data["price_incl_vat"], "460.00")

    def test_service_and_tariff_api_carry_cost(self):
        from billing.serializers import ServiceSerializer

        line = Service.objects.filter(customer=self.anna, tariff=self.t4).first()
        self.assertEqual(ServiceSerializer(line).data["cost"], "60.00")
        other = Service.objects.filter(customer=self.anna, tariff=self.t10).first()
        self.assertIsNone(ServiceSerializer(other).data["cost"])
        admin = self._user(role="admin", name="boss")
        self.api.force_authenticate(admin)
        res = self.api.patch(f"/api/tariffs/{self.t10.pk}/", {"cost_price": "250.00"}, format="json")
        self.assertEqual(res.status_code, 200, res.data)
        self.assertEqual(res.data["cost_price"], "250.00")
        cleared = self.api.patch(f"/api/tariffs/{self.t10.pk}/", {"cost_price": None}, format="json")
        self.assertIsNone(cleared.data["cost_price"])
