class ExportClientsTests(ReportFixture):
    """?clients=1 lists each row's clients for the CSV (13 Oct 2026)."""

    def test_tariff_rows_carry_their_clients(self):
        rows = self._by_name(self._get("/api/reports/clients-per-tariff/?status=active,online&clients=1").data)
        self.assertEqual([c["full_name"] for c in rows["Wireless 4 Mbps"]["client_list"]], ["Anna", "Ben"])
        self.assertEqual([c["full_name"] for c in rows["No live service"]["client_list"]], ["Cara"])

    def test_partner_rows_carry_their_clients(self):
        rows = self._by_name(self._get("/api/reports/clients-per-partner/?status=active,online&clients=1").data)
        self.assertEqual([c["full_name"] for c in rows["Acme"]["client_list"]], ["Ben", "Cara"])

    def test_excel_has_summary_and_clients_sheets(self):
        import io

        from openpyxl import load_workbook

        res = self._get("/api/reports/clients-per-tariff/?status=active,online&filetype=xlsx")
        self.assertEqual(res.status_code, 200)
        self.assertIn("spreadsheetml", res["Content-Type"])
        wb = load_workbook(io.BytesIO(res.content))
        self.assertEqual(wb.sheetnames, ["Summary", "Clients"])
        clients = [row[1] for row in wb["Clients"].iter_rows(min_row=2, values_only=True)]
        self.assertEqual(sorted(clients), ["Anna", "Anna", "Ben", "Cara"])
        summary_names = [row[1] for row in wb["Summary"].iter_rows(values_only=True)]
        self.assertIn("Anna", summary_names)
        self.assertIn("Cara", summary_names)
        res = self._get("/api/reports/clients-per-partner/?status=active,online&filetype=xlsx")
        self.assertEqual(load_workbook(io.BytesIO(res.content)).sheetnames, ["Summary", "Clients"])

    def test_client_discount_shows_in_the_list(self):
        line = Service.objects.get(customer=self.anna, tariff=self.t4)
        line.discount_type = "percentage"
        line.discount_value = Decimal("10")
        line.discount_reason = "Loyalty"
        line.save()
        rows = self._by_name(self._get("/api/reports/clients-per-tariff/?status=active,online&clients=1").data)
        anna = rows["Wireless 4 Mbps"]["client_list"][0]
        self.assertEqual(anna["discount"], "14.90")
        self.assertEqual(anna["monthly_after_discount"], "134.10")
        self.assertIn("Loyalty (10%)", anna["discount_detail"])
        ben = rows["Wireless 4 Mbps"]["client_list"][1]
        self.assertIsNone(ben["discount"])

    def test_left_out_unless_asked(self):
        rows = self._get("/api/reports/clients-per-tariff/?status=active,online").data["rows"]
        self.assertTrue(all("client_list" not in r for r in rows))


