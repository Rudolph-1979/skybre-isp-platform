"""Administration -> Reports: clients per partner / per tariff (9 Oct 2026)."""
from decimal import Decimal

from django.contrib.auth import get_user_model
from django.test import TestCase
from rest_framework.test import APIClient

from billing.models import Service, Tariff
from customers.models import Customer, Partner
from customers.scoping import DIRECT

User = get_user_model()
ALL_SECTIONS = list(User.Section.values)


class ReportFixture(TestCase):
    def setUp(self):
        self.vuma = Partner.objects.create(name="Vumatel")
        self.acme = Partner.objects.create(name="Acme")
        self.t4 = Tariff.objects.create(name="Wireless 4 Mbps", price=Decimal("149.00"), tax_rate_pct=Decimal("15"))
        self.t10 = Tariff.objects.create(name="Fibre 10 Mbps", price=Decimal("400.00"), tax_rate_pct=Decimal("15"))
        # Direct client, two lines: Skybre wireless (direct) + a Vumatel fibre line.
        self.anna = Customer.objects.create(full_name="Anna", status="active")
        Service.objects.create(customer=self.anna, tariff=self.t4, status="active")
        Service.objects.create(customer=self.anna, tariff=self.t10, status="active", partner=self.vuma)
        # Acme client, one suspended line (counted, not billed) + one terminated (ignored).
        self.ben = Customer.objects.create(full_name="Ben", status="online", partner=self.acme)
        Service.objects.create(customer=self.ben, tariff=self.t4, status="suspended")
        Service.objects.create(customer=self.ben, tariff=self.t10, status="terminated")
        # Acme client with no service at all.
        self.cara = Customer.objects.create(full_name="Cara", status="active", partner=self.acme)
        # Inactive client -- out unless the filter asks for it.
        self.dan = Customer.objects.create(full_name="Dan", status="inactive")
        Service.objects.create(customer=self.dan, tariff=self.t4, status="active")
        self.api = APIClient()
        self.staff = self._user(name="staff")

    def _user(self, sections=None, role="support", allowed=None, name="u"):
        return User.objects.create_user(
            username=name, password="pw-for-tests-123", role=role,
            allowed_sections=ALL_SECTIONS if sections is None else sections,
            allowed_partners=allowed or [],
        )

    def _get(self, url, user=None):
        self.api.force_authenticate(user or self.staff)
        return self.api.get(url)

    @staticmethod
    def _by_name(data):
        return {r["name"]: r for r in data["rows"]}

class AdminReportTests(ReportFixture):
    def test_per_partner_counts_each_line_partner(self):
        res = self._get("/api/reports/clients-per-partner/?status=active,online")
        self.assertEqual(res.status_code, 200, res.data)
        rows = self._by_name(res.data)
        self.assertEqual(rows["Direct (no partner)"]["clients"], 1)        # Anna
        self.assertEqual(rows["Direct (no partner)"]["monthly_excl"], "149.00")
        self.assertEqual(rows["Vumatel"]["clients"], 1)                     # Anna's fibre line
        self.assertEqual(rows["Vumatel"]["monthly_excl"], "400.00")
        self.assertEqual(rows["Acme"]["clients"], 2)                        # Ben + Cara
        self.assertEqual(rows["Acme"]["services"], 1)                       # terminated left out
        self.assertEqual(rows["Acme"]["monthly_excl"], "0.00")              # suspended not billed
        # Anna is in two rows but one client.
        self.assertEqual(res.data["total"]["clients"], 3)
        self.assertEqual(res.data["total"]["services"], 3)
        self.assertEqual(res.data["total"]["monthly_excl"], "549.00")

    def test_per_tariff_and_no_live_service_row(self):
        res = self._get("/api/reports/clients-per-tariff/?status=active,online")
        rows = self._by_name(res.data)
        self.assertEqual(rows["Wireless 4 Mbps"]["clients"], 2)             # Anna, Ben
        self.assertEqual(rows["Wireless 4 Mbps"]["active_services"], 1)
        self.assertEqual(rows["Fibre 10 Mbps"]["clients"], 1)               # Anna only (Ben's is terminated)
        self.assertEqual(rows["No live service"]["clients"], 1)             # Cara
        self.assertEqual(res.data["total"]["clients"], 3)

    def test_status_filter_empty_means_all_and_bad_value_refused(self):
        res = self._get("/api/reports/clients-per-tariff/")
        self.assertEqual(res.data["total"]["clients"], 4)                   # Dan included
        res = self._get("/api/reports/clients-per-tariff/?status=nonsense")
        self.assertEqual(res.status_code, 400)

    def test_click_through_lists_the_clients(self):
        res = self._get(f"/api/reports/clients-per-partner/clients/?key={self.acme.pk}&status=active,online")
        self.assertEqual(res.status_code, 200, res.data)
        self.assertEqual([r["full_name"] for r in res.data["results"]], ["Ben", "Cara"])
        ben = res.data["results"][0]
        self.assertEqual([s["tariff"] for s in ben["services"]], ["Wireless 4 Mbps"])
        res = self._get("/api/reports/clients-per-tariff/clients/?key=none&status=active,online")
        self.assertEqual([r["full_name"] for r in res.data["results"]], ["Cara"])
        res = self._get("/api/reports/clients-per-partner/clients/?key=direct&status=active,online")
        self.assertEqual([r["full_name"] for r in res.data["results"]], ["Anna"])
        self.assertEqual(res.data["results"][0]["monthly_excl"], "149.00")

    def test_needs_administration_section(self):
        no_admin = [s for s in ALL_SECTIONS if s != "administration"]
        res = self._get("/api/reports/clients-per-partner/", self._user(sections=no_admin, name="desk"))
        self.assertEqual(res.status_code, 403)
        res = self._get("/api/reports/clients-per-tariff/clients/?key=none", self._user(sections=no_admin, name="d2"))
        self.assertEqual(res.status_code, 403)
        # Admin always has it, whatever is ticked.
        res = self._get("/api/reports/clients-per-partner/", self._user(sections=[], role="admin", name="boss"))
        self.assertEqual(res.status_code, 200)

    def test_customer_role_gets_nothing(self):
        user = User.objects.create_user(username="cust", password="pw-for-tests-123", role="customer")
        res = self._get("/api/reports/clients-per-partner/", user)
        self.assertEqual(res.status_code, 404)

    def test_partner_restricted_user_sees_only_their_partners(self):
        # Vumatel only: Anna is visible (her fibre line), but only that line.
        user = self._user(allowed=[self.vuma.pk], name="vuma")
        res = self._get("/api/reports/clients-per-partner/?status=active,online", user)
        self.assertEqual(set(self._by_name(res.data)), {"Vumatel"})
        self.assertEqual(res.data["total"]["monthly_excl"], "400.00")
        res = self._get("/api/reports/clients-per-tariff/?status=active,online", user)
        self.assertEqual(set(self._by_name(res.data)), {"Fibre 10 Mbps"})
        # Acme + Direct: Anna's direct line, Ben, Cara -- never the Vumatel line.
        user = self._user(allowed=[self.acme.pk, DIRECT], name="acme")
        res = self._get("/api/reports/clients-per-partner/?status=active,online", user)
        self.assertEqual(set(self._by_name(res.data)), {"Acme", "Direct (no partner)"})
        self.assertEqual(res.data["total"]["clients"], 3)


