const DOCUMENT_TEMPLATE_KEYS: (EmailTemplateKey | "")[] = ["invoice", "quote", "proforma"];

// Wording follows the document's own status, matching the heading the PDF
// itself prints.
// Local date, not toISOString() -- that converts to UTC first, so in
// SAST (UTC+2) anything before 02:00 comes back as yesterday and the date
// input's `min` would silently permit a date the backend then rejects.
function todayIso() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
}

// Rand discounts are typed incl. VAT (George, 13 Oct 2026) but stored and
// billed excl. VAT, the way the tariff price is. Cents, ROUND_HALF_UP like
// the backend.
function inclFromExclCents(exclCents: number, ratePct: number) {
  return Math.floor((exclCents * (100 + ratePct)) / 100 + 0.5 + 1e-9);
}
function inclVatText(excl: string | number, ratePct: number) {
  const cents = Math.round(Number(excl) * 100);
  return (inclFromExclCents(cents, ratePct) / 100).toFixed(2);
}
// The excl. VAT amount (to the cent) whose incl. VAT figure is what was
// typed. Some incl. amounts can't be hit exactly at 15%; then the nearest.
function exclFromIncl(incl: string | number, ratePct: number) {
  const target = Math.round(Number(incl) * 100);
  const base = Math.round((target * 100) / (100 + ratePct));
  let best = base;
  for (const c of [base, base - 1, base + 1]) {
    if (inclFromExclCents(c, ratePct) === target) return c / 100;
    if (Math.abs(inclFromExclCents(c, ratePct) - target) < Math.abs(inclFromExclCents(best, ratePct) - target)) best = c;
  }
  return best / 100;
}

function docNounFor(invoice: Pick<Invoice, "status" | "total">) {
  // A credit note is an Invoice row with a negative total (no separate
  // CreditNote model -- see CreditRequest.create_credit_note_invoice and
  // billing/statements.py's movements()). Checked first: an imported or
  // adjusted credit note can carry any status word, same as a normal
  // invoice, so status alone can't tell the two apart.
  if (parseFloat(invoice.total) < 0) return "credit note";
  return invoice.status === "quote" ? "quote" : invoice.status === "proforma" ? "pro forma" : "invoice";
}

