          <span className="font-mono">{customerRef || "this customer's reference"}</span>.
        </p>
        <p className="mt-2 text-xs text-[var(--text-muted)]">
          Each invoice's own Paid/Unpaid badge is an approximation — the file has no per-invoice
          payment allocation, only one running account balance — but the customer's overall balance
          this leaves them at is exact.
        </p>
      </div>

      <input
        type="file"
        accept=".xlsx,.csv,.tsv,.txt,text/plain"
        className={inputClass}
        onChange={(e) => { setFile(e.target.files?.[0] ?? null); setPlan(null); setDone(false); }}
      />

      {error && <p className="mt-3 text-sm text-[var(--status-critical)]">{error}</p>}

      {plan?.errors?.map((e) => (
        <p key={e} className="mt-3 rounded-md border border-[var(--status-critical)] p-2 text-sm text-[var(--status-critical)]">{e}</p>
