// Import a customer's billing history from a previous system.
//
// Two steps, never one. Preview writes nothing and reports every row, its
// VAT split and the net effect on the balance; commit is only reachable
// after a clean preview. A migration is run two or three times before it is
// right, and the mistake you cannot undo is the one that went straight in.
function LedgerImportModal({ customerId, customerName, customerRef, onClose, onDone }: {
  customerId: number; customerName: string; customerRef: string;
  onClose: () => void; onDone: () => void;
}) {
  const [file, setFile] = useState<File | null>(null);
  const [plan, setPlan] = useState<LedgerPlan | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [done, setDone] = useState(false);

  async function send(path: "preview" | "commit") {
    if (!file) return;
    setBusy(true); setError(null);
    const body = new FormData();
    body.append("file", file);
    try {
      const res = await api.post<LedgerPlan>(`/customers/${customerId}/import-ledger-${path}/`, body);
      setPlan(res.data);
      if (path === "commit" && !res.data.errors?.length) { setDone(true); onDone(); }
    } catch (err: any) {
      setPlan(err?.response?.data ?? null);
      setError(apiErrorMessage(err, "The import could not be read."));
    } finally { setBusy(false); }
  }

  // Pre-filled with THIS customer's name and reference, and one worked row
  // of each type. A headers-only template would leave the hard parts
  // unanswered: that there are four row types in one file, that the
  // reference belongs in a line above the headings, and that dates are
  // day-first. Showing it is quicker than describing it.
  const TEMPLATE_LINES = [
    `${customerName}  (${customerRef})`,
    "ID,Type,Number,Date,Total,Due,Payment date,Status",
    "1,Recurring invoice,INV202401000438,01/11/2024,R379.00,,04/11/2024,Paid",
    "2,Payment,RCP2024-07-00345,04/11/2024,R379.00,,04/11/2024,",
    "3,One-time invoice,INV202606003378,06/07/2026,R3958.46,,10/07/2026,Paid",
    "4,Credit note,CN202501001444,25/04/2025,R437.75,,,Closed",
  ];

  function downloadTemplate() {
    const blob = new Blob([TEMPLATE_LINES.join("\n") + "\n"], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `ledger_${customerRef || customerId}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }

  const problems = plan?.rows?.filter((r) => r.action === "error") ?? [];
  const willWrite = plan?.rows?.filter((r) => r.action.startsWith("create")) ?? [];
  const canCommit = !!plan && !plan.errors?.length && willWrite.length > 0 && !done;

  return (
    <Modal title="Import billing history" onClose={onClose}>
      <p className="mb-3 text-sm text-[var(--text-muted)]">
        The ledger export from your previous system — invoices, payments and credit notes for this
        customer. Totals are read as <strong>VAT-inclusive</strong>. Nothing is written until you
        press Import.
      </p>

      <div className="mb-3 rounded-md border border-[var(--border-hairline)] p-3">
        <div className="mb-2 flex items-center justify-between gap-3">
          <span className="text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
            Expected format
          </span>
          <button type="button" className="text-sm text-[var(--series-1)] underline" onClick={downloadTemplate}>
            Download template
          </button>
        </div>
        <pre className="overflow-x-auto whitespace-pre text-[11px] leading-5 text-[var(--text-muted)]">
{TEMPLATE_LINES.join("\n")}
        </pre>
        <p className="mt-2 text-xs text-[var(--text-muted)]">
          Four row types in one file. Dates are <strong>day-first</strong> — 04/08/2026 is 4 August.
          Tab-separated works too. The reference on the first line must be{" "}
          <span className="font-mono">{customerRef || "this customer's reference"}</span>, which is how
          the import knows the file belongs to this account.
        </p>
      </div>

      <input
        type="file"
        accept=".xlsx,.csv,.tsv,.txt,text/plain"
        className={inputClass}
        onChange={(e) => { setFile(e.target.files?.[0] ?? null); setPlan(null); setDone(false); }}
      />

      {error && <p className="mt-3 text-sm text-[var(--status-critical)]">{error}</p>}

      {plan?.errors?.map((e) => (
        <p key={e} className="mt-3 rounded-md border border-[var(--status-critical)] p-2 text-sm text-[var(--status-critical)]">{e}</p>
      ))}

      {/* Object.keys, not just truthiness -- a failed parse still returns
          a summary object, and an empty one rendered a box of blank
          figures under the error message. */}
      {plan?.summary && Object.keys(plan.summary).length > 0 && (
        <div className="mt-4 rounded-md border border-[var(--border-hairline)] p-3 text-sm">
          <div className="grid grid-cols-2 gap-x-4 gap-y-1">
            <span className="text-[var(--text-muted)]">Invoices</span><span>{plan.summary.invoices}</span>
            <span className="text-[var(--text-muted)]">Payments</span><span>{plan.summary.payments}</span>
            <span className="text-[var(--text-muted)]">Credit notes</span><span>{plan.summary.credits}</span>
            <span className="text-[var(--text-muted)]">Already imported</span><span>{plan.summary.skipped}</span>
            <span className="text-[var(--text-muted)]">Rows with a problem</span><span>{plan.summary.errors}</span>
          </div>
          {Number(plan.summary.rounded ?? 0) > 0 && (
            <p className="mt-2 text-xs text-[var(--text-muted)]">
              {plan.summary.rounded} invoice(s) carry a one-cent rounding line. Some totals — R379.00
              among them — can't be expressed as an ex-VAT amount plus 15% once both halves are
              rounded to cents, so the line makes the document add up to what was actually paid.
            </p>
          )}
          {/* The number that matters. A partial ledger -- invoices without
              their payments, or the reverse -- leaves a balance that looks
              like a real debt and nobody can explain it six months on. */}
          <p className="mt-3 border-t border-[var(--border-hairline)] pt-2">
            Balance change: <strong>R{plan.summary.balance_change}</strong>
            <span className="text-[var(--text-muted)]">
              {" "}(R{plan.summary.invoiced_total} invoiced − R{plan.summary.paid_total} paid
              {" "}− R{plan.summary.credited_total} credited)
            </span>
          </p>
        </div>
      )}

      {problems.length > 0 && (
        <div className="mt-3 max-h-48 overflow-y-auto rounded-md border border-[var(--status-critical)] p-2 text-xs">
          <p className="mb-1 font-medium text-[var(--status-critical)]">
            {problems.length} row(s) will be skipped:
          </p>
          {problems.map((r) => (
            <p key={r.line} className="text-[var(--text-muted)]">
              <span className="font-mono">{r.number || `line ${r.line}`}</span> — {r.message}
            </p>
          ))}
        </div>
      )}

      {done && (
        <p className="mt-3 text-sm text-[var(--series-1)]">
          Imported {plan?.written?.invoices ?? 0} invoice(s), {plan?.written?.payments ?? 0} payment(s)
          and {plan?.written?.credits ?? 0} credit note(s).
        </p>
      )}

      <div className="mt-4 flex justify-end gap-2">
        <button type="button" className={btnSecondary} onClick={onClose}>
          {done ? "Close" : "Cancel"}
        </button>
        {!done && (
          <button type="button" className={btnSecondary} disabled={!file || busy} onClick={() => send("preview")}>
            {busy ? "Reading…" : "Preview"}
          </button>
        )}
        {canCommit && (
          <button type="button" className={btnPrimary} disabled={busy} onClick={() => send("commit")}>
            Import {willWrite.length} row(s)
          </button>
        )}
      </div>
    </Modal>
  );
}

