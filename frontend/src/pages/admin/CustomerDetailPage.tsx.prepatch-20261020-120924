  ];

  function downloadTemplate() {
    const blob = new Blob([TEMPLATE_LINES.join("\n") + "\n"], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `transactions_${customerRef || customerId}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }

  const problems = plan?.rows?.filter((r) => r.action === "error") ?? [];
  const summary = plan?.summary;
  const willWriteCount = summary
    ? Number(summary.invoices ?? 0) + Number(summary.payments ?? 0) + Number(summary.credits ?? 0)
