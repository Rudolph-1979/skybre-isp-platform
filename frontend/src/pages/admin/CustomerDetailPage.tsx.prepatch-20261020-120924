  async function send(path: "preview" | "commit") {
    if (!file) return;
    setBusy(true); setError(null);
    const body = new FormData();
    body.append("file", file);
    try {
      const res = await api.post<TxnPlan>(`/customers/${customerId}/import-transactions-${path}/`, body);
      setPlan(res.data);
      if (path === "commit" && !res.data.errors?.length) { setDone(true); onDone(); }
