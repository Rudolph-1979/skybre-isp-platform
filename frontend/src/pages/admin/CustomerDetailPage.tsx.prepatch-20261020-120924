  function openChargeModal(link: CustomerRecurringCharge | "new") {
    setChargeError(null);
    setChargeForm(
      link === "new"
        ? {
            charge: "", quantity: "1", start_date: localIsoDate(), end_date: "", note: "",
            discount_type: "none", discount_value: "", discount_starts_on: "", discount_ends_on: "", discount_reason: "",
          }
        : {
            charge: String(link.charge),
            quantity: String(link.quantity),
            start_date: link.start_date,
            end_date: link.end_date ?? "",
            note: link.note,
            discount_type: link.discount_type ?? "none",
            discount_value:
              link.discount_type === "amount" || link.discount_type === "surcharge"
                ? inclVatText(link.discount_value, parseFloat(link.tax_rate_pct || "0"))
                : link.discount_type === "percentage"
                ? String(parseFloat(link.discount_value))
                : "",
            discount_starts_on: link.discount_starts_on ?? "",
            discount_ends_on: link.discount_ends_on ?? "",
            discount_reason: link.discount_reason ?? "",
          }
    );
    setChargeModal(link);
    if (id) {
      // The charges this client's partner may be given -- the same rule the
      // API enforces, asked of the server rather than re-written here.
      api
        .get<{ results: RecurringCharge[] }>(`/recurring-charges/?page_size=200&is_active=true&for_customer=${id}`)
        .then((res) => setChargeCatalog(res.data.results));
    }
  }

  function chargeVatRate(): number {
    const c = chargeCatalog.find((x) => String(x.id) === chargeForm.charge);
    if (c) return parseFloat(c.tax_rate_pct || "0");
    if (chargeModal && chargeModal !== "new") return parseFloat(chargeModal.tax_rate_pct || "0");
    return 0;
  }
  function chargeListPrice(): number {
    const c = chargeCatalog.find((x) => String(x.id) === chargeForm.charge);
    const price = c ? parseFloat(c.price) : chargeModal && chargeModal !== "new" ? parseFloat(chargeModal.price) : 0;
    return price * Number(chargeForm.quantity || 1);
  }

  async function handleChargeSubmit(e: FormEvent) {
    e.preventDefault();
    if (!id || chargeModal === null) return;
    setChargeSaving(true);
    setChargeError(null);
    const payload = {
      customer: Number(id),
      charge: Number(chargeForm.charge),
      quantity: Number(chargeForm.quantity || 1),
      start_date: chargeForm.start_date,
      end_date: chargeForm.end_date || null,
      note: chargeForm.note,
      discount_type: chargeForm.discount_type,
      discount_value:
        chargeForm.discount_type === "none"
          ? 0
          : chargeForm.discount_type === "percentage"
          ? Number(chargeForm.discount_value || 0)
          : exclFromIncl(chargeForm.discount_value || 0, chargeVatRate()),
      discount_starts_on: chargeForm.discount_starts_on || null,
      discount_ends_on: chargeForm.discount_ends_on || null,
      discount_reason: chargeForm.discount_reason,
    };
    try {
      if (chargeModal === "new") await api.post("/customer-recurring-charges/", payload);
      else await api.patch(`/customer-recurring-charges/${chargeModal.id}/`, payload);
      setChargeModal(null);
      refetchCustomerCharges();
    } catch (err: any) {
      const data = err?.response?.data;
      const message = data && typeof data === "object" ? Object.values(data).flat().join(" ") : null;
      setChargeError(message || "Couldn't save this recurring service.");
    } finally {
      setChargeSaving(false);
    }
  }

