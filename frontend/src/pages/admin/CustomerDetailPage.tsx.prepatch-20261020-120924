  const canCommit = !!plan && !plan.errors?.length && willWriteCount > 0 && !done;

  return (
    <Modal title="Import transactions" onClose={onClose}>
      <p className="mb-3 text-sm text-[var(--text-muted)]">
        The <strong>Transaction Report</strong> export from your previous system — every debit and
        credit for this customer, in order, each with its own running account balance. Richer than a
        plain ledger export: it can capture a settlement the ledger export has no row for at all.
        Totals are read as <strong>VAT-inclusive</strong>. Nothing is written until you press Import.
      </p>

      <div className="mb-3 rounded-md border border-[var(--border-hairline)] p-3">
        <div className="mb-2 flex items-center justify-between gap-3">
          <span className="text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
            Expected format
          </span>
          <button type="button" className="text-sm text-[var(--series-1)] underline" onClick={downloadTemplate}>
