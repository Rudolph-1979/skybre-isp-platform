  // Active / starts later / ended, for the Status column -- from its own
  // dates, the same rule the billing run uses.
  function chargeStatus(link: CustomerRecurringCharge): { status: string; label: string } {
    const today = localIsoDate();
    if (link.start_date > today) return { status: "pending", label: `Starts ${formatIsoDate(link.start_date)}` };
    if (link.end_date && link.end_date <= today) return { status: "terminated", label: "Ended" };
    if (link.end_date) return { status: "active", label: `Active · ends ${formatIsoDate(link.end_date)}` };
    return { status: "active", label: "Active" };
  }

