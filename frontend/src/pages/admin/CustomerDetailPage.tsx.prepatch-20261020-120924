  const customerMainAddress = customer
    ? [customer.address, customer.complex_or_area, customer.city, customer.zip_code].filter(Boolean).join(", ") ||
      (customer.latitude != null ? `GPS ${coordinatesText(customer.latitude, customer.longitude)}` : "")
