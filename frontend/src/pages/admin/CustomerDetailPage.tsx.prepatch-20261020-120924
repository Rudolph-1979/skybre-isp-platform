      await api.post(`/customer-deletion-requests/${deletionRequest.id}/reject/`, { decision_note: rejectDecisionNote });
      setRejectingDeletion(false);
      setRejectDecisionNote("");
      refetchDeletionRequest();
    } finally {
      setDeletionBusy(false);
