  async function handleWithdrawDeletion() {
    if (!deletionRequest) return;
    if (!confirm("Withdraw this deletion request?")) return;
    await api.delete(`/customer-deletion-requests/${deletionRequest.id}/`);
    refetchDeletionRequest();
