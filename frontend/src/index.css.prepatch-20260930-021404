@import "tailwindcss";

:root {
  --surface-1: #fcfcfb;
  --surface-2: #ffffff; /* input/field backgrounds — a step "up" from surface-1 in light mode */
  --page-plane: #f9f9f7;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --text-muted: #898781;
  --gridline: #e1e0d9;
  --baseline: #c3c2b7;
  --border-hairline: rgba(11, 11, 11, 0.10);

  /* Subtle tints used for hover states, table-header washes, and the
     modal backdrop — kept as variables (rather than bg-black/5-style
     Tailwind opacity utilities) specifically so dark mode can flip them
     to white-based tints instead of black-based ones. */
  --tint-subtle: rgba(11, 11, 11, 0.02);
  --tint-hover: rgba(11, 11, 11, 0.05);
  --overlay-scrim: rgba(11, 11, 11, 0.4);

  --series-1: #2a78d6; /* blue */
  --series-2: #eb6834; /* orange */
  /* Chart fills, kept SEPARATE from --series-* above. Those double as text
     accent colours (link ink, "scheduled change" notes), where the constraint
     is 4.5:1 against body text; these are marks on a chart surface, where the
     constraint is the dataviz lightness band plus colourblind separation from
     each other. One token can't satisfy both, and the dark steps below are
     genuinely different values -- validated per mode, not flipped.
     Verified with the dataviz validator: all six checks pass in both modes. */
  --chart-1: #2a78d6;
  --chart-2: #eb6834;
  --series-3: #1baf7a; /* aqua */
  --series-4: #eda100; /* yellow */
  --series-5: #e87ba4; /* magenta */
  --series-6: #008300; /* green */
  --series-7: #4a3aa7; /* violet */
  --series-8: #e34948; /* red */

  --status-good: #0ca30c;
  --status-warning: #fab219;
  --status-serious: #ec835a;
  --status-critical: #d03b3b;

  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color-scheme: light;
}

:root.dark {
  --surface-1: #1c1c1a;
  --surface-2: #242422;
  --page-plane: #131312;
  --text-primary: #f3f2ef;
  --text-secondary: #b8b6ae;
  --text-muted: #83817a;
  --gridline: #35342f;
  --baseline: #46453e;
  --border-hairline: rgba(255, 255, 255, 0.10);

  --tint-subtle: rgba(255, 255, 255, 0.03);
  --tint-hover: rgba(255, 255, 255, 0.07);
  --overlay-scrim: rgba(0, 0, 0, 0.6);

  /* Slightly brightened so the accent colors keep enough contrast against
     dark surfaces — the hues stay recognizable, just lifted a bit. */
  --series-1: #5b9ce6;
  --series-2: #f08a5d;
  --chart-1: #4a8fdb;
  --chart-2: #d2703c;
  --series-3: #3fcf9a;
  --series-4: #f0b632;
  --series-5: #ef9dc0;
  --series-6: #3aa53a;
  --series-7: #7566d6;
  --series-8: #ea6e6d;

  --status-good: #3ecf3e;
  --status-warning: #fbc752;
  --status-serious: #f0a081;
  --status-critical: #e26969;

  color-scheme: dark;
}

body {
  margin: 0;
  background: var(--page-plane);
  color: var(--text-primary);
}

/* Native <select> dropdowns.
 *
 * An <option> INHERITS `color` from its <select> but has no background of
 * its own -- its computed background-color is transparent, and the popup
 * list paints its own surface underneath. In dark mode that pairs
 * near-white inherited text with the browser's light popup, which is the
 * "I can't read the options" bug: every option is white-on-white except
 * the one row the OS highlights for you.
 *
 * `color-scheme: dark` on :root (set above) does NOT fix this on its own,
 * which is the trap -- it darkens the control itself and the scrollbars,
 * so the closed select looks perfectly fine and only the opened list is
 * broken. Setting both properties on the option is the only thing that
 * reliably reaches the popup.
 *
 * Deliberately an element selector rather than a utility class: this has
 * to hold for every <select> in the app, including ones added later by
 * somebody who has never read this comment. */
option {
  background-color: var(--surface-1);
  color: var(--text-primary);
}

/* The group heading is a label, not a choice -- muted, with its child
 * options put back to full contrast (they'd otherwise inherit the muted
 * colour through the optgroup). */
optgroup {
  background-color: var(--surface-1);
  color: var(--text-muted);
}

optgroup option {
  color: var(--text-primary);
}

option:disabled {
  color: var(--text-muted);
}

.tabular-nums {
  font-variant-numeric: tabular-nums;
}
